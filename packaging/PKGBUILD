# Maintainer: SilverX <serainox@gmail.com>
#
# Packages the Szmelc AUR (SAUR) tool from the checkout this PKGBUILD lives in, so SAUR
# publishes itself: cd packaging && makepkg -si
pkgname=saur
pkgver=0.3.1
pkgrel=1
pkgdesc="Build, publish and serve Szmelc AUR (SAUR): a self-updating, signed pacman repository with stable and experimental channels"
arch=('any')
url="https://github.com/Szmelc-INC/SAUR"
license=('MIT')
depends=('bash' 'git' 'curl' 'jq' 'pacman' 'libarchive' 'util-linux')
optdepends=(
  'docker: container builds on any distro'
  'podman: rootless container builds'
  'gnupg: sign and verify packages, databases and lists (saur key, sign, verify)'
  'github-cli: sync packages with a GitHub release (saur release)'
  'python: saur serve'
  'darkhttpd: saur serve (preferred)'
)

package() {
  local root="$startdir/.."
  install -Dm755 "$root/bin/saur" "$pkgdir/usr/bin/saur"

  "$root/bin/saur" completion bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/saur"
  "$root/bin/saur" completion zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_saur"
  "$root/bin/saur" completion fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/saur.fish"

  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$root/saur.conf" "$root/repos.extra" "$root/repos.ignore" -t "$pkgdir/usr/share/doc/$pkgname/examples/"
}
