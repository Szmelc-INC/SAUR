<script>
const root = document.documentElement, q = document.getElementById('q'), empty = document.getElementById('empty');
const tabs = document.querySelectorAll('.tab'), body = document.getElementById('rows'), sort = document.getElementById('sort');
const themeBtn = document.getElementById('theme');
const save = (k, v) => { try { localStorage.setItem(k, v); } catch (e) {} };
const load = (k) => { try { return localStorage.getItem(k); } catch (e) { return null; } };
let ch = 'stable';
const apply = () => {
  const s = q.value.toLowerCase();
  let shown = 0;
  for (const tr of body.rows) {
    tr.hidden = !tr.textContent.toLowerCase().includes(s) || (ch !== 'all' && tr.dataset.ch !== ch);
    if (!tr.hidden) shown++;
  }
  empty.style.display = shown ? 'none' : 'block';
  document.querySelector('thead').hidden = !shown;
  empty.textContent = s ? 'No packages match "' + q.value + '".' : 'No ' + ch + ' packages right now.';
};
const select = (f) => {
  if (!['stable', 'experimental', 'all'].includes(f)) f = 'stable';
  ch = f;
  document.body.dataset.tab = f;
  for (const t of tabs) t.setAttribute('aria-selected', String(t.dataset.f === f));
  apply();
};
const order = () => {
  const k = sort.value, rows = Array.from(body.rows);
  rows.sort((a, b) => k === 'new' ? b.dataset.built - a.dataset.built
    : k === 'size' ? b.dataset.size - a.dataset.size : a.dataset.name.localeCompare(b.dataset.name));
  for (const r of rows) body.appendChild(r);
};
const theme = (t) => {
  if (t === 'light') root.dataset.theme = 'light'; else delete root.dataset.theme;
  themeBtn.textContent = t === 'light' ? 'Dark' : 'Light';
  themeBtn.setAttribute('aria-pressed', String(t === 'light'));
};
for (const t of tabs) t.addEventListener('click', () => { history.replaceState(null, '', '#' + t.dataset.f); select(t.dataset.f); });
window.addEventListener('hashchange', () => select(location.hash.slice(1)));
q.addEventListener('input', apply);
sort.addEventListener('change', () => { order(); save('saur-sort', sort.value); });
themeBtn.addEventListener('click', () => { const t = root.dataset.theme === 'light' ? 'dark' : 'light'; theme(t); save('saur-theme', t); });
document.addEventListener('keydown', (e) => {
  if (e.key === '/' && document.activeElement !== q && !e.ctrlKey && !e.metaKey) { e.preventDefault(); q.focus(); }
  else if (e.key === 'Escape' && document.activeElement === q) { q.value = ''; apply(); q.blur(); }
});
document.addEventListener('click', (e) => {
  const b = e.target.closest('.cp');
  if (!b || !navigator.clipboard) return;
  const pre = b.parentNode.querySelector('pre');
  navigator.clipboard.writeText(b.dataset.cp || (pre ? pre.textContent : '')).then(() => {
    const label = b.textContent;
    b.textContent = 'copied'; b.classList.add('done');
    setTimeout(() => { b.textContent = label; b.classList.remove('done'); }, 1200);
  });
});
const saved = load('saur-sort');
if (saved && sort.querySelector('option[value="' + saved + '"]')) { sort.value = saved; order(); }
theme(root.dataset.theme === 'light' ? 'light' : 'dark');
select(location.hash.slice(1));
</script>
</body>
</html>
EOF
  ok "site: $st_n stable + $ex_n experimental packages ($signed_n signed), add/add-ex, index.html, packages.json, feed.xml"
}

cmd_list() {
  JSON=0
  local want=all
  while (($#)); do
    case $1 in
      --json) JSON=1 ;;
      -c|--channel) want=$2; shift ;;
      -s|--stable) want=stable ;;
      -x|--ex|--experimental) want=experimental ;;
      -h|--help) help_cmd list; exit 0 ;;
      *) die "unknown flag: $1" ;;
    esac
    shift
  done
  if [[ $want != all ]]; then want=$(normalize_channel "$want") || die "unknown channel (stable|experimental|all)"; fi
  [[ -f $DB ]] || die "no database yet at $DB (run: saur run)"
  local recs; recs=$(db_records_all | awk -F'\t' -v w="$want" 'w == "all" || $1 == w')
  if ((JSON)); then
    jq -R -s --arg sfx "$SAUR_EX_SUFFIX" 'split("\n") | map(select(length > 0) | split("\t")
      | {name: .[1], version: .[2], description: (.[3] | sub("^ $"; "")), filename: .[4], channel: .[0]})' <<<"$recs"
    return
  fi
  awk -F'\t' -v OFS='\t' -v cs="$ACC" -v ce="$EXC" -v r="$R" \
    '{ print $2, $3, ($1 == "stable" ? cs : ce) $1 r, substr($4, 1, 64) }' <<<"$recs" |
    grep . | table $'NAME\tVERSION\tCHANNEL\tDESCRIPTION'
}

cmd_status() {
  JSON=0
  while (($#)); do case $1 in --json) JSON=1 ;; -h|--help) help_cmd status; exit 0 ;; *) die "unknown flag: $1" ;; esac; shift; done
  state_load
  local url
  if ((JSON)); then
    for url in "${!ST_SHA[@]}"; do
      jq -nc --arg id "$(key_id "$url")" --arg url "$(key_url "$url")" --arg sha "${ST_SHA[$url]}" --arg status "${ST_STATUS[$url]}" \
        --arg branch "$(key_is_default "$url" && echo - || echo "${url#*#}")" --arg ch "$(key_channels "$url")" \
        --arg p "${ST_PKGS[$url]}" --argjson t "${ST_TIME[$url]:-0}" \
        '{id:$id,url:$url,branch:(if $branch=="-" then null else $branch end),channel:(if $ch=="-" then null else $ch end),
          sha:$sha,status:$status,packages:($p|split(",")|map(select(.!=""))),time:$t}'
    done | jq -s 'sort_by(.id)'
    return
  fi
  local ok_n=0 fail_n=0 none_n=0
  for url in "${!ST_STATUS[@]}"; do
    case ${ST_STATUS[$url]} in ok) ok_n=$((ok_n + 1)) ;; fail) fail_n=$((fail_n + 1)) ;; *) none_n=$((none_n + 1)) ;; esac
  done
  local st_n ex_n
  st_n=$(db_records_all | grep -c '^stable' || true)
  ex_n=$(db_records_all | grep -c '^experimental' || true)
  printf '%sSzmelc AUR%s %s  ·  %s%d ok%s  %s%d failed%s  %s%d idle%s  ·  [%s] %s stable, [%s] %s experimental\n\n' \
    "$B" "$R" "$ARCH" "$GRN" "$ok_n" "$R" "$RED" "$fail_n" "$R" "$D" "$none_n" "$R" \
    "$(channel_repo stable)" "$st_n" "$(channel_repo experimental)" "$ex_n"
  local c
  for url in "${!ST_STATUS[@]}"; do
    [[ ${ST_STATUS[$url]} == none || ${ST_STATUS[$url]} == merged ]] && continue
    c=$GRN; [[ ${ST_STATUS[$url]} == fail ]] && c=$RED
    printf '%s\t%s%s%s\t%s\t%s\t%s\t%s\n' "$(key_id "$url")" "$c" "${ST_STATUS[$url]}" "$R" "$(key_channels "$url")" \
      "${ST_SHA[$url]:0:10}" "$(date -d "@${ST_TIME[$url]:-0}" '+%F %H:%M')" "${ST_PKGS[$url]}"
  done | sort -f | table $'SOURCE\tSTATUS\tCHANNEL\tSHA\tCHECKED\tPACKAGES'
}

cmd_release() {
  local sub=${1:-}
  shift || true
  case $sub in -h|--help) help_cmd release; exit 0 ;; '') help_cmd release; exit 1 ;; esac
  have gh || die "release needs the GitHub CLI (gh)"
  local tag=$ARCH repo=$SAUR_GH_REPO
  case $sub in
    pull)
      mkdir -p "$REPODIR"
      if ! gh release view "$tag" -R "$repo" >/dev/null 2>&1; then info "no release '$tag' yet, starting empty"; return 0; fi
      step "Downloading release $repo@$tag"
      gh release download "$tag" -R "$repo" -D "$REPODIR" --clobber
      # Build state rides along as an asset: committing it would move this repo's own
      # HEAD every night and make SAUR rebuild itself forever.
      if [[ -f $REPODIR/$NAME-state.tsv ]]; then mkdir -p "$STATEDIR"; mv -f "$REPODIR/$NAME-state.tsv" "$STATE"; fi
      # GitHub stores ':' (epoch) as '.', restore the names pacman expects.
      local fn
      while IFS=$'\t' read -r _ _ _ _ fn _; do
        [[ $fn == *:* ]] || continue
        if [[ ! -f $REPODIR/$fn && -f $REPODIR/${fn//:/.} ]]; then mv "$REPODIR/${fn//:/.}" "$REPODIR/$fn"; fi
        if [[ ! -f $REPODIR/$fn.sig && -f $REPODIR/${fn//:/.}.sig ]]; then mv "$REPODIR/${fn//:/.}.sig" "$REPODIR/$fn.sig"; fi
      done < <(db_records_all)
      ok "$(find "$REPODIR" -name '*.pkg.tar.*' | wc -l) packages restored"
      ;;
    push)
      db_init; db_materialize
      if [[ -n $SAUR_KEY && $SAUR_SIGN != 0 ]]; then
        local bad
        bad=$(verify_rows | awk -F'\t' '$1 != "site" && $3 != "ok" { print $2 " (" $3 ")" }')
        [[ -z $bad ]] || die "refusing to publish, clients would reject these (saur sign / saur verify):"$'\n'"$bad"
        ok "every package and database is signed by $(fpr_pretty "$SAUR_KEY")"
      fi
      gh release view "$tag" -R "$repo" >/dev/null 2>&1 ||
        gh release create "$tag" -R "$repo" --title "Szmelc AUR · $tag" --latest=false \
          --notes "Package storage for Szmelc AUR (SAUR), $tag: [$NAME] stable and [$(channel_repo experimental)] experimental. Add it: curl -fsSL $SAUR_URL/add | sudo bash"
      step "Syncing release $repo@$tag"
      local -A remote=() local_files=()
      local name size f
      while IFS=$'\t' read -r name size; do [[ -n $name ]] && remote[$name]=$size; done \
        < <(gh release view "$tag" -R "$repo" --json assets -q '.assets[] | "\(.name)\t\(.size)"')
      local -a up=()
      for f in "$REPODIR"/*.pkg.tar.*; do
        name=${f##*/}; name=${name//:/.}; local_files[$name]=1
        [[ ${remote[$name]:-} == "$(stat -c %s "$f")" ]] || up+=("$f")
      done
      ((${#up[@]} == 0)) || gh release upload "$tag" -R "$repo" --clobber "${up[@]}"
      # Database last, so the mirror never points at packages it lacks.
      local -a dbf
      mapfile -t dbf < <(db_files)
      for f in "${dbf[@]}"; do local_files[${f##*/}]=1; done
      gh release upload "$tag" -R "$repo" --clobber "${dbf[@]}"
      if [[ -f $STATE ]]; then
        local_files[$NAME-state.tsv]=1
        mkdir -p "$WORK"
        cp "$STATE" "$WORK/$NAME-state.tsv"
        gh release upload "$tag" -R "$repo" --clobber "$WORK/$NAME-state.tsv"
      fi
      for name in "${!remote[@]}"; do
        [[ -n ${local_files[$name]:-} ]] || gh release delete-asset "$tag" "$name" -R "$repo" -y
      done
      ok "release synced: ${#up[@]} package(s) uploaded"
      ;;
    *) die "unknown release action: $sub (pull|push)" ;;
  esac
}

cmd_serve() {
  local port=$SAUR_PORT bind=0.0.0.0
  while (($#)); do
    case $1 in
      -p|--port) port=$2; shift ;;
      -b|--bind) bind=$2; shift ;;
      -h|--help) help_cmd serve; exit 0 ;;
      *) die "unknown flag: $1" ;;
    esac
    shift
  done
  [[ -d $OUT ]] || die "nothing to serve yet in $OUT (run: saur run)"
  db_materialize 2>/dev/null || true
  info "serving $OUT on http://$bind:$port  (pacman: Server = http://<this-host>:$port/\$arch)"
  if have darkhttpd; then exec darkhttpd "$OUT" --port "$port" --addr "$bind"
  elif have python3; then exec python3 -m http.server "$port" --bind "$bind" --directory "$OUT"
  elif have busybox; then exec busybox httpd -f -p "$bind:$port" -h "$OUT"
  else die "need darkhttpd, python3 or busybox to serve"
  fi
}

cmd_timer() {
  local sub=${1:-status} at='*-*-* 00:00:00' port=$SAUR_PORT
  shift || true
  while (($#)); do
    case $1 in
      --at) at=$2; shift ;;
      -p|--port) port=$2; shift ;;
      -h|--help) help_cmd timer; exit 0 ;;
      *) die "unknown flag: $1" ;;
    esac
    shift
  done
  local dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
  case $sub in
    install)
      mkdir -p "$dir"
      cat >"$dir/saur-build.service" <<EOF
[Unit]
Description=SAUR: rebuild changed packages
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=SAUR_HOME=$SAUR_HOME
ExecStart=$SELF run
EOF
      cat >"$dir/saur-build.timer" <<EOF
[Unit]
Description=SAUR: nightly rebuild

[Timer]
OnCalendar=$at
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
EOF
      cat >"$dir/saur-serve.service" <<EOF
[Unit]
Description=SAUR: serve the pacman repository over HTTP
After=network.target

[Service]
Environment=SAUR_HOME=$SAUR_HOME
ExecStart=$SELF serve --port $port
Restart=on-failure

[Install]
WantedBy=default.target
EOF
      systemctl --user daemon-reload
      systemctl --user enable --now saur-build.timer saur-serve.service
      ok "installed: nightly build ($at) and HTTP server on :$port"
      info "keep them running after logout: loginctl enable-linger $USER"
      ;;
    remove)
      systemctl --user disable --now saur-build.timer saur-serve.service 2>/dev/null || true
      rm -f "$dir"/saur-{build.service,build.timer,serve.service}
      systemctl --user daemon-reload
      ok "removed SAUR user units"
      ;;
    status) systemctl --user list-timers saur-build.timer --no-pager; systemctl --user status saur-serve.service --no-pager || true ;;
    *) die "unknown timer action: $sub (install|remove|status)" ;;
  esac
}

cmd_extra() {
  local sub=${1:-ls} f=$SAUR_HOME/repos.extra r
  shift || true
  case $sub in
    ls|list) if [[ -f $f ]]; then grep -Ev '^\s*(#|$)' "$f" || true; fi ;;
    add)
      local ch= line
      local -a srcs=()
      while (($#)); do
        case $1 in
          -x|--ex|--experimental) ch=experimental ;;
          -s|--stable) ch=stable ;;
          *) srcs+=("$1") ;;
        esac
        shift
      done
      ((${#srcs[@]})) || die "usage: saur extra add [--ex|--stable] OWNER/REPO[@branch] | URL[@branch]"
      for r in "${srcs[@]}"; do
        line=$r${ch:+ $ch}
        if grep -qE "^[[:space:]]*$(printf '%s' "$r" | sed 's/[][\.*^$+?(){}|/]/\\&/g')([[:space:]]|$)" "$f" 2>/dev/null; then
          info "already listed: $r"; continue
        fi
        echo "$line" >>"$f"; ok "added $line"
      done ;;
    rm|remove)
      (($#)) || die "usage: saur extra rm OWNER/REPO"
      for r in "$@"; do
        local re; re=$(printf '%s' "$r" | sed 's/[][\.*^$+?(){}|/]/\\&/g')
        if ! grep -qE "^[[:space:]]*$re([[:space:]]|$)" "$f" 2>/dev/null; then warn "not listed: $r"; continue; fi
        grep -vE "^[[:space:]]*$re([[:space:]]|$)" "$f" >"$f.tmp" || true; mv "$f.tmp" "$f"; ok "removed $r"
      done ;;
    -h|--help) help_cmd extra ;;
    *) die "unknown extra action: $sub (ls|add|rm)" ;;
  esac
}

cmd_key() {
  local sub=${1:-show}
  shift || true
  case $sub in -h|--help) help_cmd key; exit 0 ;; esac
  have gpg || die "key needs gpg (gnupg)"
  local kf; kf=$(key_file)
  case $sub in
    show)
      JSON=0
      while (($#)); do case $1 in --json) JSON=1 ;; -h|--help) help_cmd key; exit 0 ;; *) die "unknown flag: $1" ;; esac; shift; done
      [[ -n $SAUR_KEY ]] || die "no signing key configured (create one: saur key gen)"
      local uid='' created='' secret=missing cols
      if [[ -f $kf ]]; then cols=$(gpg --batch --with-colons --show-keys "$kf" 2>/dev/null || true)
      else cols=$(gpg --batch --with-colons --list-keys "$SAUR_KEY" 2>/dev/null || true); fi
      uid=$(awk -F: '$1 == "uid" { print $10; exit }' <<<"$cols")
      created=$(awk -F: '$1 == "pub" { print $6; exit }' <<<"$cols")
      [[ -n $created ]] && created=$(date -u -d "@$created" +%F)
      if [[ -n $SIGNING_KEY_ARMOR ]]; then secret='SAUR_GPG_KEY'
      elif gpg --batch --with-colons --list-secret-keys "$SAUR_KEY" 2>/dev/null | grep -q '^sec'; then secret='gpg keyring'; fi
      if ((JSON)); then
        jq -n --arg fpr "$SAUR_KEY" --arg uid "$uid" --arg created "$created" --arg file "$kf" --argjson exists "$([[ -f $kf ]] && echo true || echo false)" \
          --arg secret "$secret" --arg sign "$SAUR_SIGN" \
          '{fingerprint:$fpr, uid:$uid, created:$created, keyfile:$file, keyfile_exists:$exists, secret:$secret, sign:$sign}'
        return
      fi
      local sc=$GRN; [[ $secret == missing ]] && sc=$YLW
      {
        printf 'fingerprint\t%s%s%s\n' "$ACC" "$(fpr_pretty "$SAUR_KEY")" "$R"
        printf 'user id\t%s\n' "${uid:--}"
        printf 'created\t%s\n' "${created:--}"
        printf 'public key\t%s%s\n' "$kf" "$([[ -f $kf ]] || printf ' %s(missing: saur key export > %s)%s' "$D" "$kf" "$R")"
        printf 'secret key\t%s%s%s\n' "$sc" "$secret" "$R"
        printf 'signing\t%s\n' "$SAUR_SIGN"
      } | table $'KEY\tVALUE'
      ;;
    export)
      if [[ -f $kf ]]; then cat "$kf"
      elif [[ -n $SAUR_KEY ]]; then gpg --batch --armor --export "$SAUR_KEY"
      else die "no signing key configured (saur key gen)"; fi
      ;;
    gen)
      local name='Szmelc AUR' email='' force=0 upload=0
      while (($#)); do
        case $1 in
          -n|--name) name=$2; shift ;;
          -e|--email) email=$2; shift ;;
          -f|--force) force=1 ;;
          -u|--upload) upload=1 ;;
          -h|--help) help_cmd key; exit 0 ;;
          *) die "unknown flag: $1" ;;
        esac
        shift
      done
      [[ -z $SAUR_KEY || $force == 1 ]] || die "SAUR_KEY is already set ($(fpr_pretty "$SAUR_KEY")); --force makes a new one"
      local uid="$name (package signing)${email:+ <$email>}" fpr
      step "Generating an ed25519 signing key: $uid"
      fpr=$(gpg --batch --pinentry-mode loopback --passphrase '' --status-fd 1 --quick-gen-key "$uid" ed25519 sign never 2>/dev/null |
        awk '$2 == "KEY_CREATED" { print $4 }')
      [[ -n $fpr ]] || die "gpg could not create the key"
      mkdir -p "$(dirname "$kf")"
      gpg --batch --armor --export "$fpr" >"$kf"
      local conf=$SAUR_HOME/saur.conf
      if grep -q '^SAUR_KEY=' "$conf" 2>/dev/null; then sed -i -E "s/^(SAUR_KEY=)[^[:space:]#]*/\1$fpr/" "$conf"
      else printf 'SAUR_KEY=%s   # signing key fingerprint (saur key)\n' "$fpr" >>"$conf"; fi
      SAUR_KEY=$fpr
      ok "key $(fpr_pretty "$fpr")"
      info "public key: $kf (commit it), SAUR_KEY set in $conf"
      info "secret key: in ${GNUPGHOME:-$HOME/.gnupg}; revocation certificate: ${GNUPGHOME:-$HOME/.gnupg}/openpgp-revocs.d/$fpr.rev"
      info "back it up: gpg --export-secret-keys --armor $fpr > saur-secret.asc (keep it offline)"
      ((upload)) && cmd_key upload
      ;;
    upload)
      [[ -n $SAUR_KEY ]] || die "no signing key configured (saur key gen)"
      have gh || die "upload needs the GitHub CLI (gh)"
      gpg --batch --with-colons --list-secret-keys "$SAUR_KEY" 2>/dev/null | grep -q '^sec' || die "no secret key for $SAUR_KEY in gpg"
      gpg --batch --armor --export-secret-keys "$SAUR_KEY" | gh secret set SAUR_GPG_KEY -R "$SAUR_GH_REPO"
      ok "secret SAUR_GPG_KEY set on $SAUR_GH_REPO"
      ;;
    *) die "unknown key action: $sub (show|export|gen|upload)" ;;
  esac
}

cmd_sign() {
  local force=0
  while (($#)); do
    case $1 in -f|--force) force=1 ;; -h|--help) help_cmd sign; exit 0 ;; *) die "unknown flag: $1" ;; esac
    shift
  done
  [[ -n $SAUR_KEY ]] || die "no signing key configured (saur key gen)"
  have repo-add || die "sign needs repo-add (pacman) to embed package signatures"
  SAUR_SIGN=1
  db_init
  sign_repo "$force"
  db_materialize
  sign_site "$force"
  ok "signed with $(fpr_pretty "$SAUR_KEY")"
}

cmd_verify() {
  JSON=0
  local all=0
  while (($#)); do
    case $1 in --json) JSON=1 ;; -a|--all) all=1 ;; -h|--help) help_cmd verify; exit 0 ;; *) die "unknown flag: $1" ;; esac
    shift
  done
  [[ -n $SAUR_KEY ]] || die "no signing key configured: nothing to verify against"
  ring_init || die "cannot load the public key ($(key_file))"
  local rows bad total
  rows=$(verify_rows)
  total=$(grep -c . <<<"$rows" || true)
  bad=$(awk -F'\t' '$3 != "ok"' <<<"$rows" | grep -c . || true)
  if ((JSON)); then
    jq -R -s --arg fpr "$SAUR_KEY" '{key: $fpr, files: (split("\n") | map(select(length > 0) | split("\t")
      | {kind: .[0], file: .[1], status: .[2]}))} | .ok = ([.files[] | select(.status != "ok")] | length == 0)' <<<"$rows"
  else
    local shown
    shown=$(awk -F'\t' -v a="$all" 'a == 1 || $3 != "ok"' <<<"$rows")
    if [[ -n $shown ]]; then
      awk -F'\t' -v OFS='\t' -v g="$GRN" -v e="$RED" -v r="$R" '{ print $1, $2, ($3 == "ok" ? g : e) $3 r }' <<<"$shown" |
        table $'KIND\tFILE\tSTATUS'
      echo
    fi
  fi
  if ((bad)); then err "$bad of $total file(s) not signed by $(fpr_pretty "$SAUR_KEY")"; return 1; fi
  ((JSON)) || ok "$total file(s) signed by $(fpr_pretty "$SAUR_KEY")"
}

cmd_config() {
  local v
  case ${1:-} in
    --json)
      for v in SAUR_HOME "${CONFIG_VARS[@]}"; do jq -nc --arg k "$v" --arg v "${!v}" '{($k):$v}'; done | jq -s add
      return ;;
    -h|--help) help_cmd config; exit 0 ;;
  esac
  for v in SAUR_HOME "${CONFIG_VARS[@]}"; do printf '%s\t%s\n' "$v" "${!v}"; done | table $'KEY\tVALUE'
}

cmd_doctor() {
  local t bad=0
  printf '%sSzmelc AUR · saur %s%s  home: %s\n\n' "$B" "$SAUR_VERSION" "$R" "$SAUR_HOME"
  for t in git curl jq tar bsdtar makepkg repo-add vercmp gpg gpgv gh docker podman python3 darkhttpd systemctl; do
    if have "$t"; then printf '  %s✓%s %s\n' "$GRN" "$R" "$t"; else printf '  %s·%s %s %s(missing)%s\n' "$YLW" "$R" "$t" "$D" "$R"; fi
  done
  echo
  for t in git curl jq; do have "$t" || { err "required: $t"; bad=1; }; done
  if ! { have makepkg && have repo-add; } && ! { have docker || have podman; }; then
    err "building needs Arch tools (makepkg, repo-add) or a container engine (docker/podman)"; bad=1
  fi
  [[ -f $SAUR_HOME/saur.conf ]] || warn "no saur.conf in $SAUR_HOME (defaults in use; run: saur init)"
  if [[ -z $SAUR_KEY ]]; then
    warn "no signing key: clients get an unsigned repo (SigLevel = Optional TrustAll; create one: saur key gen)"
  elif [[ ! -f $(key_file) ]]; then
    err "SAUR_KEY is set but the public key $(key_file) is missing (saur key export > $(key_file))"; bad=1
  elif [[ -n $SIGNING_KEY_ARMOR ]] || gpg --batch --with-colons --list-secret-keys "$SAUR_KEY" 2>/dev/null | grep -q '^sec'; then
    ok "signing key $(fpr_pretty "$SAUR_KEY") ready"
  else
    warn "signing key $(fpr_pretty "$SAUR_KEY"): public only here, builds stay unsigned (SAUR_GPG_KEY or gpg --import)"
  fi
  ((bad == 0)) || return 1
  ok "ready"
}

cmd_init() {
  mkdir -p "$SAUR_HOME"
  if [[ -f $SAUR_HOME/saur.conf ]]; then info "$SAUR_HOME/saur.conf exists"; return 0; fi
  cat >"$SAUR_HOME/saur.conf" <<EOF
# Szmelc AUR (SAUR) configuration (bash). Overrides: saur.local.conf, then SAUR_* env vars.
SAUR_NAME=$SAUR_NAME
SAUR_ORG=$SAUR_ORG
SAUR_ARCH=$SAUR_ARCH
SAUR_URL=http://$(hostname):$SAUR_PORT
SAUR_MIRRORS=''
SAUR_KEY=                           # signing key fingerprint, set by: saur key gen
EOF
  touch "$SAUR_HOME/repos.extra" "$SAUR_HOME/repos.ignore"
  ok "initialized $SAUR_HOME"
  info "sign what you publish: saur key gen"
}

cmd_clean() {
  case ${1:-} in -h|--help) help_cmd clean; exit 0 ;; esac
  rm -rf "$WORK/src" "$WORK/pkgdest" "$LOGS"
  if [[ ${1:-} == --all ]]; then rm -rf "$WORK"; fi
  ok "cleaned $WORK"
}

# ---------------------------------------------------------------------------
# Help and completion
# ---------------------------------------------------------------------------
usage() {
  cat <<EOF
${B}saur${R} ${D}$SAUR_VERSION${R} · build, publish and serve Szmelc AUR (SAUR)

${B}USAGE${R}
  saur [global flags] <command> [flags]

${B}COMMANDS${R}
  ${ACC}run${R}         scan, build what changed, then generate the site ${D}(what CI and the timer call)${R}
  ${ACC}build${R}       scan and build what changed, update the repo database
  ${ACC}scan${R}        show every source (repo branch) and what would happen to it
  ${ACC}site${R}        write index.html, packages.json, feed.xml and the add/add-ex scripts
  ${ACC}list${R}        list packages, stable and experimental
  ${ACC}status${R}      per-source build state and channel
  ${ACC}serve${R}       serve the repository over HTTP
  ${ACC}release${R}     pull|push packages to the GitHub release used as storage
  ${ACC}key${R}         show|export|gen|upload the signing key
  ${ACC}sign${R}        sign every package, database and list that lacks a valid signature
  ${ACC}verify${R}      check every signature against SAUR_KEY
  ${ACC}timer${R}       install|remove|status systemd user units (nightly build + server)
  ${ACC}extra${R}       ls|add|rm repos outside the org
  ${ACC}config${R}      print the effective configuration
  ${ACC}doctor${R}      check required tools
  ${ACC}init${R}        create a config for a self-hosted instance
  ${ACC}clean${R}       remove build leftovers
  ${ACC}completion${R}  print shell completion (bash|zsh|fish)

${B}GLOBAL FLAGS${R}
  -H, --home DIR   SAUR home (config, state, output)  ${D}[\$SAUR_HOME]${R}
  -q, --quiet      only warnings and errors
      --no-color   disable colors  ${D}[\$NO_COLOR]${R}
  -V, --version    print version
  -h, --help       this help; ${B}saur help <command>${R} for details
EOF
}

help_cmd() {
  case ${1:-} in
    run|build) cat <<EOF
${B}saur $1${R} [flags] [REPO...]

Scan every branch of every repo in the org (and repos.extra), clone each branch
whose HEAD moved, build every PKGBUILD it holds and update the databases.
Failures are isolated per package and retried only when the branch changes.
${B}run${R} also regenerates the site.
Without --native this runs inside an Arch container (docker/podman).

${B}Channels${R}
  stable        [$(channel_repo stable)]   default branch
  experimental  [$(channel_repo experimental)]  any other branch; packages, commands, man pages and
                completions get the suffix '$SAUR_EX_SUFFIX' (foo -> foo$SAUR_EX_SUFFIX)
  A PKGBUILD overrides this with ${B}_saur_channel=stable|experimental|skip${R}, sees
  ${B}\$SAUR_CHANNEL${R} while building, and can turn the renaming off with ${B}_saur_ex_rename=0${R}.
  Branches merged into the default one, or matching SAUR_IGNORE_BRANCHES, are skipped.

  -f, --force         rebuild everything (or every matched REPO)
  -r, --retry-failed  retry failed packages even if unchanged
  -n, --dry-run       only print what would be built
      --native        build on this machine (Arch, as root: CI/containers)
      --container     always use a container
  REPO                limit to matching sources (name, owner/name, owner/name#branch or substring)
EOF
    ;;
    scan) printf '%s\n' "${B}saur scan${R} [--json] [REPO...]" "" "List all sources (one per repo branch) with HEAD, last state and planned action." ;;
    site) printf '%s\n' "${B}saur site${R}" "" \
      "Write index.html, packages.json, packages.txt, feed.xml (Atom, 50 newest builds), key.asc" \
      "and the add/add-ex scripts into SAUR_OUT. With a signing key, add, add-ex, packages.json and" \
      "packages.txt get .asc signatures and the add scripts trust that key and require signatures." \
      "index.html: Stable / Experimental / All tabs (link one with #stable, #experimental, #all)," \
      "filter (press /), sort, dark theme with a light toggle, links to SAUR_HOMEPAGE and GitHub." \
      "Colors: SAUR_COLOR (accent, #105c5c), SAUR_EX_COLOR (experimental, #750f0f)," \
      "SAUR_SILVER (second accent, #c0c0c0), SAUR_AQUA (rare highlight, #7fffd4)." ;;
    key) cat <<EOF
${B}saur key${R} [show [--json] | export | gen [-n NAME] [-e EMAIL] [-u] [-f] | upload]

The OpenPGP key that signs packages, databases and the site's lists.
  show     fingerprint, user id, where the public and secret halves are ${D}(default)${R}
  export   print the armored public key ${D}(SAUR_KEYFILE, else from gpg)${R}
  gen      create an ed25519 signing key in your gpg keyring (no passphrase, no expiry),
           write the public key to SAUR_KEYFILE and SAUR_KEY to saur.conf
           -n, --name NAME    user id name ${D}(default: Szmelc AUR)${R}
           -e, --email EMAIL  user id email
           -u, --upload       also run 'saur key upload'
           -f, --force        replace an existing SAUR_KEY
  upload   store the secret key as the GitHub Actions secret SAUR_GPG_KEY on SAUR_GH_REPO

The secret key comes from the gpg keyring or from \$SAUR_GPG_KEY (armored, how CI passes it).
SAUR_SIGN=auto signs when it is at hand, 1 makes a missing key fatal, 0 turns signing off.
EOF
    ;;
    sign) printf '%s\n' "${B}saur sign${R} [-f|--force]" "" \
      "Sign every package, database and site list in SAUR_OUT that lacks a valid signature by SAUR_KEY," \
      "and re-add signed packages so the databases embed their signatures. Builds do this on their own;" \
      "use it after importing old packages or changing keys (--force re-signs everything). Needs repo-add." ;;
    verify) printf '%s\n' "${B}saur verify${R} [-a|--all] [--json]" "" \
      "Check every package, database and site list in SAUR_OUT against SAUR_KEY (public key only)." \
      "Lists problems (--all: every file) and exits 1 if anything is unsigned or badly signed." ;;
    list) printf '%s\n' "${B}saur list${R} [-s|--stable] [-x|--ex] [-c|--channel stable|experimental|all] [--json]" "" "List packages of both channels (or one)." ;;
    status) printf '%s\n' "${B}saur status${R} [--json]" "" "Show build state and channel per source (repo or repo#branch)." ;;
    serve) printf '%s\n' "${B}saur serve${R} [-p PORT] [-b ADDR]" "" "Serve SAUR_OUT over HTTP (darkhttpd, python3 or busybox)." ;;
    release) printf '%s\n' "${B}saur release${R} pull|push" "" "pull: download all packages from the GitHub release into SAUR_OUT." \
      "push: upload new packages, signatures and the databases, delete stale assets. Needs gh." \
      "With SAUR_KEY set, push refuses anything that is not signed by it." ;;
    timer) printf '%s\n' "${B}saur timer${R} install|remove|status [--at CALENDAR] [-p PORT]" "" "Self-hosting: a systemd user timer for 'saur run' (default midnight)" "and a service running 'saur serve'." ;;
    extra) printf '%s\n' "${B}saur extra${R} ls|add|rm [-x|--ex|-s|--stable] [OWNER/REPO[@branch] | URL[@branch]]" "" \
      "Manage repos.extra: repos built in addition to the org." \
      "Without @branch every branch is scanned like an org repo; @branch pins one branch." \
      "--ex / --stable force the channel (a PKGBUILD's _saur_channel still wins)." ;;
    config) printf '%s\n' "${B}saur config${R} [--json]" "" "Print the effective configuration (defaults < saur.conf < saur.local.conf < env)." ;;
    doctor) printf '%s\n' "${B}saur doctor${R}" "" "Check the tools SAUR needs and whether the signing key is usable." ;;
    init) printf '%s\n' "${B}saur init${R}" "" "Create saur.conf, repos.extra and repos.ignore in SAUR_HOME." ;;
    clean) printf '%s\n' "${B}saur clean${R} [--all]" "" "Remove clones and logs (--all: the whole work dir, incl. pacman cache)." ;;
    completion) printf '%s\n' "${B}saur completion${R} bash|zsh|fish" "" "Print a completion script. Example: saur completion zsh > ~/.zfunc/_saur" ;;
    ''|help) usage ;;
    *) die "unknown command: $1" ;;
  esac
}

cmd_completion() {
  case ${1:-} in
    bash) cat <<'EOF'
# bash completion for saur
_saur() {
  local cur=${COMP_WORDS[COMP_CWORD]} cmd=${COMP_WORDS[1]}
  if ((COMP_CWORD == 1)); then
    COMPREPLY=($(compgen -W "run build scan site list status serve release key sign verify timer extra config doctor init clean completion help version --home --quiet --no-color --version --help" -- "$cur")); return
  fi
  case $cmd in
    run|build) COMPREPLY=($(compgen -W "--force --retry-failed --dry-run --native --container --help" -- "$cur")) ;;
    list) COMPREPLY=($(compgen -W "--json --stable --ex --channel --help stable experimental all" -- "$cur")) ;;
    scan|status|config) COMPREPLY=($(compgen -W "--json --help" -- "$cur")) ;;
    serve) COMPREPLY=($(compgen -W "--port --bind --help" -- "$cur")) ;;
    release) COMPREPLY=($(compgen -W "pull push" -- "$cur")) ;;
    key) COMPREPLY=($(compgen -W "show export gen upload --json --name --email --upload --force" -- "$cur")) ;;
    sign) COMPREPLY=($(compgen -W "--force --help" -- "$cur")) ;;
    verify) COMPREPLY=($(compgen -W "--all --json --help" -- "$cur")) ;;
    timer) COMPREPLY=($(compgen -W "install remove status --at --port" -- "$cur")) ;;
    extra) COMPREPLY=($(compgen -W "ls add rm --ex --stable" -- "$cur")) ;;
    clean) COMPREPLY=($(compgen -W "--all" -- "$cur")) ;;
    completion) COMPREPLY=($(compgen -W "bash zsh fish" -- "$cur")) ;;
    help) COMPREPLY=($(compgen -W "run build scan site list status serve release key sign verify timer extra config doctor init clean completion" -- "$cur")) ;;
  esac
}
complete -F _saur saur
EOF
    ;;
    zsh) cat <<'EOF'
#compdef saur
_saur() {
  local -a cmds
  cmds=(
    'run:scan, build what changed, generate the site'
    'build:scan and build what changed'
    'scan:show sources and planned actions'
    'site:generate index.html, packages.json and the add script'
    'list:list packages, stable and experimental'
    'status:per-repo build state'
    'serve:serve the repository over HTTP'
    'release:pull or push the GitHub release storage'
    'key:show, export, generate or upload the signing key'
    'sign:sign what lacks a valid signature'
    'verify:check every signature'
    'timer:manage systemd user units'
    'extra:manage repos outside the org'
    'config:print the effective configuration'
    'doctor:check required tools'
    'init:create a self-hosting config'
    'clean:remove build leftovers'
    'completion:print shell completion'
    'help:show help'
    'version:print version'
  )
  _arguments -C \
    '(-H --home)'{-H,--home}'[SAUR home]:dir:_directories' \
    '(-q --quiet)'{-q,--quiet}'[only warnings and errors]' \
    '--no-color[disable colors]' \
    '(-V --version)'{-V,--version}'[print version]' \
    '(-h --help)'{-h,--help}'[show help]' \
    '1:command:->cmd' '*::arg:->args'
  case $state in
    cmd) _describe command cmds ;;
    args)
      case $words[1] in
        run|build) _arguments '(-f --force)'{-f,--force}'[rebuild everything]' '(-r --retry-failed)'{-r,--retry-failed}'[retry failed]' \
          '(-n --dry-run)'{-n,--dry-run}'[only print the plan]' '--native[build on this machine]' '--container[use a container]' '*:repo:' ;;
        list) _arguments '--json[JSON output]' '(-s --stable)'{-s,--stable}'[stable only]' '(-x --ex)'{-x,--ex}'[experimental only]' \
          '(-c --channel)'{-c,--channel}'[channel]:channel:(stable experimental all)' ;;
        scan|status|config) _arguments '--json[JSON output]' ;;
        serve) _arguments '(-p --port)'{-p,--port}'[port]:port:' '(-b --bind)'{-b,--bind}'[address]:addr:' ;;
        release) _values action pull push ;;
        key) _arguments '1:action:(show export gen upload)' '--json[JSON output]' '(-n --name)'{-n,--name}'[user id name]:name:' \
          '(-e --email)'{-e,--email}'[user id email]:email:' '(-u --upload)'{-u,--upload}'[set the GitHub secret]' '(-f --force)'{-f,--force}'[replace the key]' ;;
        sign) _arguments '(-f --force)'{-f,--force}'[re-sign everything]' ;;
        verify) _arguments '(-a --all)'{-a,--all}'[list every file]' '--json[JSON output]' ;;
        timer) _arguments '1:action:(install remove status)' '--at[systemd calendar]:calendar:' '(-p --port)'{-p,--port}'[port]:port:' ;;
        extra) _arguments '1:action:(ls add rm)' '(-x --ex)'{-x,--ex}'[experimental channel]' '(-s --stable)'{-s,--stable}'[stable channel]' '*:repo:' ;;
        clean) _arguments '--all[remove the whole work dir]' ;;
        completion) _values shell bash zsh fish ;;
        help) _describe command cmds ;;
      esac ;;
  esac
}
_saur "$@"
EOF
    ;;
    fish) cat <<'EOF'
# fish completion for saur
set -l cmds run build scan site list status serve release key sign verify timer extra config doctor init clean completion help version
complete -c saur -f
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -s H -l home -r -d 'SAUR home'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -s q -l quiet -d 'Only warnings and errors'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -l no-color -d 'Disable colors'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -s V -l version -d 'Print version'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a run -d 'Scan, build, generate site'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a build -d 'Scan and build what changed'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a scan -d 'Show sources and planned actions'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a site -d 'Generate site files'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a list -d 'List packages (both channels)'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a status -d 'Per-repo build state'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a serve -d 'Serve over HTTP'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a release -d 'GitHub release storage'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a key -d 'Signing key'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a sign -d 'Sign what lacks a signature'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a verify -d 'Check every signature'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a timer -d 'systemd user units'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a extra -d 'Repos outside the org'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a config -d 'Effective configuration'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a doctor -d 'Check tools'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a init -d 'Create self-hosting config'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a clean -d 'Remove build leftovers'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a completion -d 'Shell completion'
complete -c saur -n "not __fish_seen_subcommand_from $cmds" -a help -d 'Show help'
complete -c saur -n "__fish_seen_subcommand_from run build" -s f -l force -d 'Rebuild everything'
complete -c saur -n "__fish_seen_subcommand_from run build" -s r -l retry-failed -d 'Retry failed'
complete -c saur -n "__fish_seen_subcommand_from run build" -s n -l dry-run -d 'Only print the plan'
complete -c saur -n "__fish_seen_subcommand_from run build" -l native -d 'Build on this machine'
complete -c saur -n "__fish_seen_subcommand_from run build" -l container -d 'Use a container'
complete -c saur -n "__fish_seen_subcommand_from scan list status config" -l json -d 'JSON output'
complete -c saur -n "__fish_seen_subcommand_from list" -s s -l stable -d 'Stable only'
complete -c saur -n "__fish_seen_subcommand_from list" -s x -l ex -d 'Experimental only'
complete -c saur -n "__fish_seen_subcommand_from list" -s c -l channel -x -a 'stable experimental all' -d 'Channel'
complete -c saur -n "__fish_seen_subcommand_from extra" -s x -l ex -d 'Experimental channel'
complete -c saur -n "__fish_seen_subcommand_from extra" -s s -l stable -d 'Stable channel'
complete -c saur -n "__fish_seen_subcommand_from serve" -s p -l port -r -d 'Port'
complete -c saur -n "__fish_seen_subcommand_from serve" -s b -l bind -r -d 'Address'
complete -c saur -n "__fish_seen_subcommand_from release" -a 'pull push'
complete -c saur -n "__fish_seen_subcommand_from key" -a 'show export gen upload'
complete -c saur -n "__fish_seen_subcommand_from key" -l json -d 'JSON output'
complete -c saur -n "__fish_seen_subcommand_from key" -s n -l name -r -d 'User id name'
complete -c saur -n "__fish_seen_subcommand_from key" -s e -l email -r -d 'User id email'
complete -c saur -n "__fish_seen_subcommand_from key" -s u -l upload -d 'Set the GitHub secret'
complete -c saur -n "__fish_seen_subcommand_from key" -s f -l force -d 'Replace the key'
complete -c saur -n "__fish_seen_subcommand_from sign" -s f -l force -d 'Re-sign everything'
complete -c saur -n "__fish_seen_subcommand_from verify" -s a -l all -d 'List every file'
complete -c saur -n "__fish_seen_subcommand_from verify" -l json -d 'JSON output'
complete -c saur -n "__fish_seen_subcommand_from timer" -a 'install remove status'
complete -c saur -n "__fish_seen_subcommand_from extra" -a 'ls add rm'
complete -c saur -n "__fish_seen_subcommand_from clean" -l all -d 'Remove the whole work dir'
complete -c saur -n "__fish_seen_subcommand_from completion" -a 'bash zsh fish'
EOF
    ;;
    -h|--help) help_cmd completion ;;
    *) die "usage: saur completion bash|zsh|fish" ;;
  esac
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
  # The armored secret key never stays in the environment: nothing below inherits it.
  SIGNING_KEY_ARMOR=${SAUR_GPG_KEY:-}
  if [[ -z $SIGNING_KEY_ARMOR && -n ${SAUR_GPG_KEY_B64:-} ]]; then
    SIGNING_KEY_ARMOR=$(base64 -d <<<"$SAUR_GPG_KEY_B64" 2>/dev/null || true)
  fi
  unset SAUR_GPG_KEY SAUR_GPG_KEY_B64
  trap sign_cleanup EXIT
  setup_colors
  while (($#)); do
    case $1 in
      -H|--home) SAUR_HOME=$2; shift ;;
      -q|--quiet) QUIET=1 ;;
      --no-color) SAUR_NO_COLOR=1; setup_colors ;;
      -V|--version) echo "saur $SAUR_VERSION"; return ;;
      -h|--help) usage; return ;;
      -*) die "unknown flag: $1 (see: saur --help)" ;;
      *) break ;;
    esac
    shift
  done
  CMD=${1:-help}
  shift || true
  resolve_home; load_config
  # All paths are absolute now. Leave the checkout so git never trips over its .git
  # (e.g. a worktree's gitfile pointing at a host path inside a container).
  cd /
  case $CMD in
    run) cmd_run "$@" ;;
    build) cmd_build "$@" ;;
    scan) cmd_scan "$@" ;;
    site) cmd_site "$@" ;;
    list|ls) cmd_list "$@" ;;
    status) cmd_status "$@" ;;
    serve) cmd_serve "$@" ;;
    release) cmd_release "$@" ;;
    key) cmd_key "$@" ;;
    sign) cmd_sign "$@" ;;
    verify) cmd_verify "$@" ;;
    timer) cmd_timer "$@" ;;
    extra) cmd_extra "$@" ;;
    config) cmd_config "$@" ;;
    doctor) cmd_doctor "$@" ;;
    init) cmd_init "$@" ;;
    clean) cmd_clean "$@" ;;
    completion) cmd_completion "$@" ;;
    help) help_cmd "${1:-}" ;;
    version) echo "saur $SAUR_VERSION" ;;
    *) die "unknown command: $CMD (see: saur --help)" ;;
  esac
}

main "$@"
