#!/usr/bin/env bash
# saur - build, publish and serve Szmelc AUR (SAUR), a pacman repository that
# rebuilds itself from every repo and branch holding a PKGBUILD. Two channels:
# [saur] stable (default branches) and [saur-ex] experimental (other branches,
# packages renamed foo -> foo-ex so both install side by side).
#
# The same script runs in GitHub Actions and on any PC (via docker/podman),
# so the repository never depends on one hosting provider.
set -Eeuo pipefail
shopt -s nullglob

SAUR_VERSION=0.2.1
SELF=$(readlink -f "${BASH_SOURCE[0]}")

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
setup_colors() {
  if [[ -z ${NO_COLOR:-} && ${SAUR_NO_COLOR:-0} != 1 ]] && { [[ -t 1 ]] || [[ -n ${GITHUB_ACTIONS:-} ]]; }; then
    B=$'\e[1m' D=$'\e[90m' R=$'\e[0m' RED=$'\e[31m' GRN=$'\e[32m' YLW=$'\e[33m' BLU=$'\e[34m' MAG=$'\e[35m' CYN=$'\e[36m'
  else
    B='' D='' R='' RED='' GRN='' YLW='' BLU='' MAG='' CYN=''
  fi
}
QUIET=0
info() { ((QUIET)) || printf '%s::%s %s\n' "$BLU" "$R" "$*" >&2; }
ok()   { ((QUIET)) || printf '%s ✓%s %s\n' "$GRN" "$R" "$*" >&2; }
warn() { printf '%s !!%s %s\n' "$YLW" "$R" "$*" >&2; }
err()  { printf '%s ✗%s %s\n' "$RED" "$R" "$*" >&2; }
die()  { err "$*"; exit 1; }
step() { ((QUIET)) || printf '\n%s==>%s %s%s%s\n' "$MAG" "$R" "$B" "$*" "$R" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }
group()    { if [[ -n ${GITHUB_ACTIONS:-} ]]; then echo "::group::$*" >&2; fi; }
endgroup() { if [[ -n ${GITHUB_ACTIONS:-} ]]; then echo "::endgroup::" >&2; fi; }

# Print TSV from stdin as an aligned table with a bold header ($1, tab-separated).
table() {
  local header=$1
  { printf '%s\n' "$header"; cat; } | if have column; then column -t -s $'\t'; else tr '\t' ' '; fi |
    { IFS= read -r h && printf '%s%s%s\n' "$B" "$h" "$R"; cat; }
}

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
CONFIG_VARS=(SAUR_NAME SAUR_EX_SUFFIX SAUR_ORG SAUR_ARCH SAUR_URL SAUR_MIRRORS SAUR_GH_REPO SAUR_INCLUDE_FORKS
  SAUR_INCLUDE_ARCHIVED SAUR_INCLUDE_PRIVATE SAUR_IGNORE_PATHS SAUR_ALL_BRANCHES SAUR_IGNORE_BRANCHES
  SAUR_BUILD_TIMEOUT SAUR_NOCHECK SAUR_COLOR SAUR_EX_COLOR
  SAUR_IMAGE SAUR_ENGINE SAUR_PACKAGER SAUR_WORK SAUR_OUT SAUR_STATE SAUR_PORT SAUR_JOBS)

resolve_home() {
  if [[ -n ${SAUR_HOME:-} ]]; then :
  elif [[ -f $PWD/saur.conf ]]; then SAUR_HOME=$PWD
  elif [[ -f ${SELF%/bin/*}/saur.conf ]]; then SAUR_HOME=${SELF%/bin/*}
  else SAUR_HOME=${XDG_DATA_HOME:-$HOME/.local/share}/saur
  fi
  SAUR_HOME=$(readlink -m "$SAUR_HOME")
}

load_config() {
  # Defaults < saur.conf < saur.local.conf < environment.
  local envsnap f
  envsnap=$(declare -px | grep -E '^declare -x SAUR_' | sed 's/^declare -x /declare -gx /' || true)
  SAUR_NAME=saur SAUR_EX_SUFFIX=-ex
  SAUR_ORG=Szmelc-INC
  SAUR_ARCH=x86_64
  SAUR_URL=https://szmelc-inc.github.io/SAUR
  SAUR_MIRRORS='https://github.com/Szmelc-INC/SAUR/releases/download/$arch'
  SAUR_GH_REPO=Szmelc-INC/SAUR
  SAUR_INCLUDE_FORKS=0 SAUR_INCLUDE_ARCHIVED=0 SAUR_INCLUDE_PRIVATE=0
  SAUR_IGNORE_PATHS='(^|/)(tests?|testdata|examples?|vendor|node_modules|third_party)/'
  SAUR_ALL_BRANCHES=1 SAUR_IGNORE_BRANCHES='^(dependabot|renovate)/|^gh-pages$'
  SAUR_BUILD_TIMEOUT=3600 SAUR_NOCHECK=0
  SAUR_COLOR=#105c5c SAUR_EX_COLOR=#750f0f
  SAUR_IMAGE=docker.io/library/archlinux:base-devel SAUR_ENGINE=
  SAUR_PACKAGER='SAUR <https://github.com/Szmelc-INC/SAUR>'
  SAUR_WORK=work SAUR_OUT=public SAUR_STATE=state SAUR_PORT=8080 SAUR_JOBS=8
  for f in "$SAUR_HOME/saur.conf" "$SAUR_HOME/saur.local.conf"; do
    # shellcheck disable=SC1090
    if [[ -f $f ]]; then source "$f"; fi
  done
  eval "$envsnap"
  abs() { if [[ $1 == /* ]]; then printf '%s' "$1"; else printf '%s/%s' "$SAUR_HOME" "$1"; fi; }
  WORK=$(abs "$SAUR_WORK") OUT=$(abs "$SAUR_OUT") STATEDIR=$(abs "$SAUR_STATE")
  ARCH=$SAUR_ARCH REPODIR=$OUT/$ARCH
  STATE=$STATEDIR/$ARCH.tsv LOGS=$WORK/logs
  BUILDER=saurbuild
  use_channel stable
}

# Two channels, two pacman repos side by side in one directory:
#   stable       [saur]     packages as named in their PKGBUILD
#   experimental [saur-ex]  the same packages renamed foo -> foo-ex (commands too)
CHANNELS=(stable experimental)
channel_repo() { if [[ $1 == experimental ]]; then printf '%s' "$SAUR_NAME$SAUR_EX_SUFFIX"; else printf '%s' "$SAUR_NAME"; fi; }
use_channel() { CHANNEL=$1 NAME=$(channel_repo "$1"); DB=$REPODIR/$NAME.db.tar.gz; }
channel_of() { # pkgname -> channel, by suffix
  if [[ -n $SAUR_EX_SUFFIX && $1 == *"$SAUR_EX_SUFFIX" ]]; then echo experimental; else echo stable; fi
}
normalize_channel() {
  case ${1,,} in
    stable|main|release) echo stable ;;
    ex|exp|experimental|testing|unstable) echo experimental ;;
    skip|none|off|no) echo skip ;;
    *) return 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# State: url \t sha \t status \t pkgnames(, or -) \t unix-time
# ---------------------------------------------------------------------------
declare -A ST_SHA=() ST_STATUS=() ST_PKGS=() ST_TIME=()
state_load() {
  [[ -f $STATE ]] || return 0
  local url sha status pkgs t
  while IFS=$'\t' read -r url sha status pkgs t; do
    [[ -z $url || $url == \#* ]] && continue
    [[ $pkgs == - ]] && pkgs=
    ST_SHA[$url]=$sha ST_STATUS[$url]=$status ST_PKGS[$url]=$pkgs ST_TIME[$url]=$t
  done <"$STATE"
}
state_save() {
  mkdir -p "$STATEDIR"
  local url tmp=$STATE.tmp
  {
    printf '# url\tsha\tstatus\tpackages\ttime\n'
    for url in "${!ST_SHA[@]}"; do
      # "-" for no packages: tab is IFS whitespace, an empty field would collapse on read.
      printf '%s\t%s\t%s\t%s\t%s\n' "$url" "${ST_SHA[$url]}" "${ST_STATUS[$url]}" "${ST_PKGS[$url]:--}" "${ST_TIME[$url]}"
    done | sort -f
  } >"$tmp"
  mv "$tmp" "$STATE"
}
state_set() { ST_SHA[$1]=$2 ST_STATUS[$1]=$3 ST_PKGS[$1]=$4 ST_TIME[$1]=$(date +%s); }
state_del() { unset 'ST_SHA[$1]' 'ST_STATUS[$1]' 'ST_PKGS[$1]' 'ST_TIME[$1]'; }

# ---------------------------------------------------------------------------
# Repository database helpers
# ---------------------------------------------------------------------------
untar() { if have bsdtar; then bsdtar -xOf "$1" "$2"; else tar --wildcards -xOzf "$1" "$2"; fi; }

# name \t version \t desc \t filename \t csize \t builddate \t url \t arch
db_records() {
  [[ -f $DB ]] || return 0
  untar "$DB" '*/desc' 2>/dev/null | awk '
    function flush() { if (d == "") d = " "; if (n != "") print n "\t" v "\t" d "\t" f "\t" c "\t" b "\t" u "\t" a; n = v = d = f = c = b = u = a = "" }
    /^%[A-Z0-9]+%$/ { if ($0 == "%FILENAME%") flush(); k = $0; next }
    /^$/ { k = ""; next }
    { gsub(/\t/, " ") }
    k == "%FILENAME%" { f = $0 } k == "%NAME%" { n = $0 } k == "%VERSION%" { v = $0 }
    k == "%DESC%" { d = $0 } k == "%CSIZE%" { c = $0 } k == "%BUILDDATE%" { b = $0 }
    k == "%URL%" { u = $0 } k == "%ARCH%" { a = $0 }
    END { flush() }' | sort -f || true
}
db_version() { db_records | awk -F'\t' -v n="$1" '$1 == n { print $2; exit }'; }

# Records of every channel, prefixed with the channel: channel \t <db_records columns>
db_records_all() {
  local ch
  for ch in "${CHANNELS[@]}"; do
    use_channel "$ch"
    db_records | sed "s/^/$ch\t/"
  done
  use_channel stable
}

db_init() {
  mkdir -p "$REPODIR"
  local ch base
  for ch in "${CHANNELS[@]}"; do
    use_channel "$ch"
    if [[ ! -f $DB ]]; then
      tar -czf "$DB" -T /dev/null
      cp "$DB" "$REPODIR/$NAME.files.tar.gz"
    fi
    for base in db files; do
      [[ -e $REPODIR/$NAME.$base ]] || ln -sf "$NAME.$base.tar.gz" "$REPODIR/$NAME.$base"
    done
  done
  use_channel stable
}

# Replace the db/files symlinks with real copies (static hosts and release assets need files).
db_materialize() {
  local ch f
  for ch in "${CHANNELS[@]}"; do
    for f in "$REPODIR/$(channel_repo "$ch")".{db,files}; do
      if [[ -L $f ]]; then cp --remove-destination "$(readlink -f "$f")" "$f"; fi
    done
  done
  rm -f "$REPODIR"/*.old
}

# Every db and files archive, symlinks included (what the release must carry).
db_files() { local ch; for ch in "${CHANNELS[@]}"; do printf '%s\n' "$REPODIR/$(channel_repo "$ch")".{db,files}{,.tar.gz}; done; }

# Delete package files no database references (both channels share the directory).
db_gc() {
  local -A keep=()
  local fn f n=0
  while IFS=$'\t' read -r _ _ _ _ fn _; do keep[$fn]=1; done < <(db_records_all)
  for f in "$REPODIR"/*.pkg.tar.*; do
    fn=${f##*/}; fn=${fn%.sig}
    [[ -n ${keep[$fn]:-} ]] || { rm -f "$f"; n=$((n + 1)); }
  done
  ((n == 0)) || info "removed $n stale package file(s)"
}

# ---------------------------------------------------------------------------
# Sources: which git repos to look at
# ---------------------------------------------------------------------------
gh_api() {
  local -a auth=()
  local tok=${GH_TOKEN:-${GITHUB_TOKEN:-}}
  [[ -n $tok ]] && auth=(-H "Authorization: Bearer $tok")
  curl -fsSL "${auth[@]}" -H 'Accept: application/vnd.github+json' "https://api.github.com/$1"
}

normalize_url() {
  local u=$1
  [[ $u == *://* || $u == git@* ]] || u=https://github.com/$u
  [[ $u == https://github.com/* && $u != *.git ]] && u=$u.git
  printf '%s' "$u"
}
short_id() { local u=${1%.git}; u=${u#https://github.com/}; printf '%s' "$u"; }

# A source is one branch of one repo. Its state key is the bare URL for the default
# branch (or an explicitly pinned one) and URL#branch for every other branch.
source_key() { if (($3)); then printf '%s' "$1"; else printf '%s#%s' "$1" "$2"; fi; } # url branch is_default
key_url() { printf '%s' "${1%%#*}"; }
key_is_default() { [[ $1 != *#* ]]; }
key_id() { if key_is_default "$1"; then short_id "$1"; else printf '%s#%s' "$(short_id "${1%%#*}")" "${1#*#}"; fi; }
slug() { key_id "$1" | tr -c 'A-Za-z0-9._-' '_'; }

# Output: url \t branch \t channel hint. Branch "-" means every branch of the repo,
# hint "-" means "let the PKGBUILD and the branch decide" (tab is IFS whitespace,
# so fields are never empty).
list_sources() {
  local org=$SAUR_ORG page=1 json n total=0
  local -a lines=()
  if [[ -n $org ]]; then
    local base="orgs/$org/repos"
    gh_api "orgs/$org" >/dev/null 2>&1 || base="users/$org/repos"
    while :; do
      json=$(gh_api "$base?per_page=100&type=all&page=$page") || die "GitHub API request failed ($base page $page)"
      n=$(jq 'length' <<<"$json")
      ((n > 0)) || break
      total=$((total + n))
      mapfile -t -O "${#lines[@]}" lines < <(jq -r \
        --argjson forks "$SAUR_INCLUDE_FORKS" --argjson arch "$SAUR_INCLUDE_ARCHIVED" --argjson priv "$SAUR_INCLUDE_PRIVATE" \
        '.[] | select((.fork | not) or $forks == 1) | select((.archived | not) or $arch == 1)
             | select((.private | not) or $priv == 1) | .clone_url + "\t-\t-"' <<<"$json")
      ((n == 100)) || break
      page=$((page + 1))
    done
    ((total > 0)) || die "no repositories found for '$org' (refusing to continue: that would unpublish everything)"
  fi
  local line url br src hint
  if [[ -f $SAUR_HOME/repos.extra ]]; then
    while IFS= read -r line; do
      line=${line%%#*}
      src= hint=
      read -r src hint _ <<<"$line" || true
      [[ -z $src ]] && continue
      url=$src br=-
      if [[ $src == git@* ]]; then
        [[ $src == git@*@* ]] && { url=${src%@*}; br=${src##*@}; }
      elif [[ $src == *@* ]]; then
        url=${src%@*} br=${src##*@}
      fi
      if [[ -n $hint ]]; then
        hint=$(normalize_channel "$hint") || { warn "repos.extra: unknown channel in '$line', ignored"; hint=-; }
      fi
      lines+=("$(normalize_url "$url")"$'\t'"$br"$'\t'"${hint:--}")
    done <"$SAUR_HOME/repos.extra"
  fi
  local -A ignore=() seen=()
  if [[ -f $SAUR_HOME/repos.ignore ]]; then
    while IFS= read -r line; do
      line=${line%%#*}; line=$(xargs <<<"$line")
      [[ -n $line ]] && ignore[${line,,}]=1
    done <"$SAUR_HOME/repos.ignore"
  fi
  local id
  for line in "${lines[@]}"; do
    url=${line%%$'\t'*}
    id=$(short_id "$url"); id=${id,,}
    [[ -n ${ignore[$id]:-} || -n ${ignore[${id##*/}]:-} || -n ${seen[$url]:-} ]] && continue
    seen[$url]=1
    printf '%s\n' "$line"
  done
}

# One ls-remote per repo lists every branch and which one is the default.
# Branches that add nothing are dropped here: ignored names, and branches still at
# the default branch's commit. An unreachable repo yields one row with sha "?".
_lsremote() {
  local url br hint out def defsha sha
  IFS=$'\t' read -r url br hint <<<"$1"
  if [[ $br != - ]]; then
    sha=$(GIT_TERMINAL_PROMPT=0 timeout 60 git ls-remote "$url" "refs/heads/$br" 2>/dev/null | awk 'NR == 1 { print $1 }') || true
    printf '%s\t%s\t%s\t1\t%s\t%s\n' "$url" "$br" "${sha:-?}" "$hint" "$br"
    return
  fi
  out=$(GIT_TERMINAL_PROMPT=0 timeout 60 git ls-remote --symref "$url" HEAD 'refs/heads/*' 2>/dev/null) || out=
  def=$(awk '$1 == "ref:" && $3 == "HEAD" { sub("^refs/heads/", "", $2); print $2; exit }' <<<"$out")
  defsha=$(awk -F'\t' '$2 == "HEAD" && $1 !~ /^ref:/ { print $1; exit }' <<<"$out")
  if [[ -z $def || -z $defsha ]]; then
    printf '%s\t-\t?\t1\t%s\t-\n' "$url" "$hint"
    return
  fi
  awk -F'\t' -v OFS='\t' -v url="$url" -v def="$def" -v defsha="$defsha" -v hint="$hint" \
    -v all="$SAUR_ALL_BRANCHES" -v ign="$SAUR_IGNORE_BRANCHES" '
    $2 ~ /^refs\/heads\// {
      b = substr($2, 12); isdef = (b == def)
      if (!isdef && (all != 1 || $1 == defsha || (ign != "" && b ~ ign))) next
      print url, b, $1, isdef, hint, def
    }' <<<"$out"
}
export -f _lsremote

# Output: url \t branch \t sha \t is_default(0|1) \t channel hint \t default branch
# Default branches sort first, so they claim package names before experiments do.
resolve_shas() {
  SAUR_ALL_BRANCHES=$SAUR_ALL_BRANCHES SAUR_IGNORE_BRANCHES=$SAUR_IGNORE_BRANCHES \
    xargs -d '\n' -r -P "$SAUR_JOBS" -n 1 bash -c '_lsremote "$1"' _ | sort -f -t $'\t' -k4,4r -k1,1 -k2,2
}

# ---------------------------------------------------------------------------
# Building
# ---------------------------------------------------------------------------
as_builder() {
  if ((EUID == 0)); then runuser -u "$BUILDER" -- env HOME="/home/$BUILDER" "$@"; else "$@"; fi
}

native_prepare() {
  ((EUID == 0)) || return 0
  id "$BUILDER" >/dev/null 2>&1 || useradd -m "$BUILDER"
  mkdir -p /etc/makepkg.conf.d
  # Arch enables split debug packages by default; SAUR does not ship them.
  printf 'OPTIONS+=(!debug)\nMAKEFLAGS="-j%s"\n' "$(nproc)" >/etc/makepkg.conf.d/saur.conf
  # Let packages depend on each other: expose the repos being built to pacman.
  local ch repo
  for ch in "${CHANNELS[@]}"; do
    repo=$(channel_repo "$ch")
    if ! grep -q "^\[$repo\]" /etc/pacman.conf; then
      printf '\n[%s]\nSigLevel = Optional TrustAll\nServer = file://%s\n' "$repo" "$REPODIR" >>/etc/pacman.conf
    fi
  done
  pacman -Sy >/dev/null 2>&1 || true
}

srcinfo_get() { awk -F' = ' -v k="$2" '$1 == "\t" k || $1 == k { print $2 }' <<<"$1"; }

# Channel of one PKGBUILD: its own _saur_channel= wins, then the repos.extra hint,
# then the branch (default branch -> stable, any other branch -> experimental).
pkgbuild_channel() { # file is_default hint label
  local c
  c=$(sed -nE "s/^[[:space:]]*_saur_channel=[\"']?([A-Za-z]+).*/\1/p" "$1" | tail -n 1)
  if [[ -n $c ]] && ! c=$(normalize_channel "$c"); then warn "$4: unknown _saur_channel, using the branch default"; c=; fi
  [[ -n $c || $3 == - ]] || c=$3
  if [[ -z $c ]]; then if (($2)); then c=stable; else c=experimental; fi; fi
  printf '%s' "$c"
}

# Appended to every experimental PKGBUILD. Renames the packages (foo -> foo-ex) and,
# inside them, commands, man pages, shell completions and desktop entries, so both
# channels install side by side. The PKGBUILD's own functions still run under the
# original names, so "$srcdir/$pkgname" or /usr/share/$pkgname keep meaning what the
# author wrote. Files that still collide with a stable package add a conflicts= entry.
# A PKGBUILD can opt out with _saur_ex_rename=0 and branch on $SAUR_CHANNEL itself.
ex_snippet() {
  cat <<'EOF'

# >>> saur: experimental channel (appended at build time) >>>
if [[ ${SAUR_CHANNEL:-} == experimental && ${_saur_ex_rename:-1} != 0 ]]; then
  _saur_sfx=${SAUR_EX_SUFFIX:--ex}
  _saur_names=("${pkgname[@]}")
  _saur_base=${pkgbase:-}
  pkgname=("${pkgname[@]/%/$_saur_sfx}")
  [[ -z $_saur_base ]] || pkgbase=$_saur_base$_saur_sfx
  pkgdesc="${pkgdesc:-} [experimental${SAUR_EX_SOURCE:+: $SAUR_EX_SOURCE}]"

  _saur_call() { # function, original pkgnames...
    local _fn=$1 _sp=("${pkgname[@]}") _sb=${pkgbase:-}
    shift
    pkgname=("$@")
    [[ -z $_saur_base ]] || pkgbase=$_saur_base
    "$_fn"
    pkgname=("${_sp[@]}")
    [[ -z $_saur_base ]] || pkgbase=$_sb
  }
  _saur_wrap() { # function, new function name, original pkgnames...
    declare -F "$1" >/dev/null || return 0
    eval "_saur_orig_$(declare -f "$1")"
    local _post=
    [[ $1 == package* ]] && _post="; _saur_ex_fix $(printf '%q' "$3")"
    eval "$2() { _saur_call _saur_orig_$1 $(printf '%q ' "${@:3}")$_post; }"
  }
  _saur_re() { printf '%s' "$1" | sed 's/[][\.*^$+?(){}|/]/\\&/g'; }

  _saur_ex_fix() { # original pkgname
    local s=$_saur_sfx f n c re t
    local -a renamed=() hit=()
    [[ $pkgdesc == *'[experimental'* ]] || pkgdesc="${pkgdesc:-} [experimental${SAUR_EX_SOURCE:+: $SAUR_EX_SOURCE}]"
    # PKGBUILDs run without nullglob: an unmatched glob comes back as itself.
    for f in "$pkgdir"/usr/bin/*; do
      [[ -e $f || -L $f ]] || continue
      n=${f##*/}
      [[ $n == *"$s" ]] && continue
      mv "$f" "$f$s"
      renamed+=("$n")
    done
    for f in "$pkgdir"/usr/share/man/man*/* "$pkgdir"/usr/share/man/*/man*/*; do
      [[ -e $f || -L $f ]] || continue
      n=${f##*/}
      [[ -d $f || ${n%%.*} == *"$s" ]] && continue
      mv "$f" "${f%/*}/${n%%.*}$s.${n#*.}"
    done
    for c in "${renamed[@]}"; do
      re=$(_saur_re "$c")
      f=$pkgdir/usr/share/bash-completion/completions/$c
      # Symlinked completions (aliases) are moved too; only real files are edited.
      if [[ -f $f || -L $f ]]; then
        mv "$f" "$f$s"
        [[ -L $f$s ]] || sed -i -E "/complete /s/([[:space:]])$re([[:space:]]|\$)/\1$c$s\2/g" "$f$s"
      fi
      f=$pkgdir/usr/share/zsh/site-functions/_$c
      if [[ -f $f || -L $f ]]; then
        mv "$f" "${f%/*}/_$c$s"
        [[ -L ${f%/*}/_$c$s ]] || sed -i -E "/^#compdef|compdef /s/([[:space:]])$re([[:space:]]|\$)/\1$c$s\2/g" "${f%/*}/_$c$s"
      fi
      for f in "$pkgdir"/usr/share/fish/{vendor_completions.d,completions}/"$c".fish; do
        [[ -f $f || -L $f ]] || continue
        mv "$f" "${f%/*}/$c$s.fish"
        [[ -L ${f%/*}/$c$s.fish ]] || sed -i -E "s/(-c|--command)([[:space:]]+)$re([[:space:]]|\$)/\1\2$c$s\3/g" "${f%/*}/$c$s.fish"
      done
    done
    for f in "$pkgdir"/usr/share/applications/*.desktop; do
      [[ -f $f && $f != *"$s.desktop" ]] || continue
      for c in "${renamed[@]}"; do
        re=$(_saur_re "$c")
        sed -i -E "s/^((Try)?Exec=(.*\/)?)$re([[:space:]]|\$)/\1$c$s\4/" "$f"
      done
      sed -i -E 's/^Name=(.*)$/Name=\1 (experimental)/' "$f"
      mv "$f" "${f%.desktop}$s.desktop"
    done
    # Licenses and docs are never read at runtime: give them the package's new name.
    for f in "$pkgdir"/usr/share/licenses/* "$pkgdir"/usr/share/doc/*; do
      [[ -e $f || -L $f ]] || continue
      [[ $f == *"$s" ]] || mv "$f" "$f$s"
    done
    # Relative symlinks whose target got renamed above (foo -> foo-ex, x.fish -> x-ex.fish).
    while IFS= read -r -d '' f; do
      t=$(readlink "$f")
      [[ $t == */* || -e ${f%/*}/$t ]] && continue
      if [[ -e ${f%/*}/$t$s ]]; then ln -sfn "$t$s" "$f"
      elif [[ $t == *.* && -e ${f%/*}/${t%.*}$s.${t##*.} ]]; then ln -sfn "${t%.*}$s.${t##*.}" "$f"
      fi
    done < <(find "$pkgdir" -type l -print0)
    # Relations inherited from the PKGBUILD would tie foo-ex back to foo: a -git package's
    # provides=(foo) conflicts=(foo) clashes with the stable build, and replaces= would make
    # pacman -Syu swap the stable package for the experimental one. Point them at -ex names.
    local -A own=()
    for n in "${_saur_names[@]}" ${_saur_base:+"$_saur_base"} "${renamed[@]}"; do
      own[$n]=1 own[${n%-git}]=1 own[${n%-bin}]=1 own[${n%-nightly}]=1 own[${n%-devel}]=1
    done
    _saur_sfx_rel() {
      local -n _arr=$1
      local i e nm
      for i in "${!_arr[@]}"; do
        e=${_arr[$i]} nm=${_arr[$i]%%[<>=]*}
        if [[ -n ${own[$nm]:-} ]]; then _arr[$i]=$nm$s${e#"$nm"}; fi
      done
    }
    _saur_sfx_rel provides
    _saur_sfx_rel conflicts
    replaces=()
    if [[ -s ${SAUR_STABLE_FILES:-} ]]; then
      mapfile -t hit < <(cd "$pkgdir" && find . -mindepth 1 ! -type d -printf '%P\n' |
        awk -F'\t' 'NR == FNR { own[$2] = own[$2] " " $1; next }
          ($0 in own) { k = split(own[$0], a, " "); for (i = 1; i <= k; i++) print a[i] }' "$SAUR_STABLE_FILES" - | sort -u)
      if ((${#hit[@]})); then
        conflicts+=("${hit[@]}")
        printf '==> saur: files still clash with stable %s, adding conflicts\n' "${hit[*]}" >&2
      fi
    fi
  }

  for _saur_f in prepare pkgver build check; do _saur_wrap "$_saur_f" "$_saur_f" "${_saur_names[@]}"; done
  if ((${#_saur_names[@]} == 1)) && ! declare -F "package_${_saur_names[0]}" >/dev/null; then
    _saur_wrap package package "${_saur_names[0]}"
  else
    for _saur_n in "${_saur_names[@]}"; do _saur_wrap "package_$_saur_n" "package_$_saur_n$_saur_sfx" "$_saur_n"; done
  fi
fi
# <<< saur <<<
EOF
}

# Files of every stable package (pkgname \t path), for the experimental conflict check.
stable_files() {
  local out=$WORK/stable-files.tsv tmp d n
  tmp=$(mktemp -d)
  tar -xzf "$REPODIR/$(channel_repo stable).files.tar.gz" -C "$tmp" 2>/dev/null || true
  for d in "$tmp"/*/; do
    [[ -f $d/desc && -f $d/files ]] || continue
    n=$(awk '/^%NAME%$/ { getline; print; exit }' "$d/desc")
    awk -v n="$n" 'NR > 1 && NF && !/\/$/ { print n "\t" $0 }' "$d/files"
  done >"$out"
  rm -rf "$tmp"
  chmod 644 "$out"
  printf '%s' "$out"
}

# Which current source publishes a package name (state key), excluding $2.
owner_of() {
  local k
  for k in "${!ST_PKGS[@]}"; do
    [[ $k == "${2:-}" ]] && continue
    if [[ ",${ST_PKGS[$k]}," == *",$1,"* ]]; then printf '%s' "$k"; return 0; fi
  done
  return 1
}
drop_name() { ST_PKGS[$1]=$(tr ',' '\n' <<<"${ST_PKGS[$1]}" | grep -vxF "$2" | paste -sd, - || true); }

# Unpublish names a source stopped producing, unless another source publishes them.
unpublish() { # key names...
  local key=$1 n
  shift
  local -a drop=()
  for n in "$@"; do owner_of "$n" "$key" >/dev/null || drop+=("$n"); done
  db_remove "${drop[@]}"
}

# Build one PKGBUILD directory into a channel. Sets BUILT_NAMES.
# Returns 0 ok, 1 failed, 2 skipped (arch, or every name belongs to another source).
BUILT_NAMES=()
EX_SOURCE=
build_one() {
  local d=$1 label=$2 channel=$3 key=$4 log srcinfo
  BUILT_NAMES=()
  use_channel "$channel"
  log="$LOGS/$(printf '%s' "$label" | tr -c 'A-Za-z0-9._-' '_').log"
  : >"$log"
  if ((EUID == 0)); then chown "$BUILDER:" "$log"; fi
  local -a chenv=(SAUR_CHANNEL="$channel" SAUR_EX_SUFFIX="$SAUR_EX_SUFFIX" SAUR_EX_SOURCE="$EX_SOURCE")
  if [[ $channel == experimental ]]; then
    ex_snippet >>"$d/PKGBUILD"
    chenv+=(SAUR_STABLE_FILES="$(stable_files)")
  fi
  if ! srcinfo=$(cd "$d" && as_builder env "${chenv[@]}" makepkg --printsrcinfo 2>>"$log"); then
    err "$label: cannot parse PKGBUILD (see $log)"; return 1
  fi
  local -a names arches deps
  mapfile -t names < <(srcinfo_get "$srcinfo" pkgname)
  mapfile -t arches < <(srcinfo_get "$srcinfo" arch | sort -u)
  local ver rel epoch
  ver=$(srcinfo_get "$srcinfo" pkgver | head -1)
  rel=$(srcinfo_get "$srcinfo" pkgrel | head -1)
  epoch=$(srcinfo_get "$srcinfo" epoch | head -1)
  if [[ " ${arches[*]} " != *" any "* && " ${arches[*]} " != *" $ARCH "* ]]; then
    warn "$label: arch (${arches[*]}) does not include $ARCH, skipping"; return 2
  fi
  local kinds='depends|makedepends'
  ((SAUR_NOCHECK)) || kinds+='|checkdepends'
  mapfile -t deps < <(awk -F' = ' -v re="^\t?($kinds)(_$ARCH)?$" '$1 ~ re { print $2 }' <<<"$srcinfo" | sort -u)

  if ((EUID == 0 && ${#deps[@]})); then
    local -a missing
    mapfile -t missing < <(pacman -T "${deps[@]}" 2>/dev/null || true)
    if ((${#missing[@]})); then
      info "$label: installing ${#missing[@]} dependencies"
      if ! pacman -S --needed --noconfirm --asdeps "${missing[@]%%[<>=]*}" >>"$log" 2>&1; then
        err "$label: dependencies not installable: ${missing[*]}"; return 1
      fi
    fi
  fi

  # A static pkgver would rebuild to the same version and nobody would upgrade:
  # bump pkgrel past the published one instead.
  if ! grep -Eq '^[[:space:]]*pkgver[[:space:]]*\(\)' "$d/PKGBUILD"; then
    local mine="${epoch:+$epoch:}$ver" cur
    cur=$(db_version "${names[0]}")
    if [[ -n $cur && ${cur%-*} == "$mine" ]] && (($(vercmp "$mine-$rel" "$cur") <= 0)); then
      local currel=${cur##*-}
      local newrel=$((${currel%%.*} + 1))
      sed -i -E "s/^pkgrel=.*/pkgrel=$newrel/" "$d/PKGBUILD"
      info "$label: same version as published ($cur), pkgrel -> $newrel"
    fi
  fi

  local pkgdest=$WORK/pkgdest/${label//[\/:]/_}
  rm -rf "$pkgdest"; mkdir -p "$pkgdest"
  if ((EUID == 0)); then chown "$BUILDER:" "$pkgdest"; fi
  local -a mflags=(-f --noconfirm --noprogressbar)
  ((SAUR_NOCHECK)) && mflags+=(--nocheck)
  ((EUID == 0)) || mflags+=(-s --needed)
  info "$label: makepkg [$NAME] (${names[*]})"
  local rc=0
  (cd "$d" && as_builder env PKGDEST="$pkgdest" PACKAGER="$SAUR_PACKAGER" "${chenv[@]}" \
    timeout "$SAUR_BUILD_TIMEOUT" makepkg "${mflags[@]}") >>"$log" 2>&1 || rc=$?
  if ((rc)); then
    err "$label: build failed (exit $rc), log: $log"
    group "build log: $label"; tail -n 60 "$log" >&2; endgroup
    return 1
  fi

  local -a files=()
  local f n o produced=0
  for f in "$pkgdest"/*.pkg.tar.*; do
    [[ $f == *.sig ]] && continue
    n=${f##*/}; n=${n%-*-*-*}
    [[ " ${names[*]} " == *" $n "* ]] || continue
    produced=1
    # One name, one source: a default branch takes a name over from a side branch,
    # anything else keeps the first source that published it.
    if o=$(owner_of "$n" "$key"); then
      if [[ -n ${CURRENT[$o]:-} ]] && ! { key_is_default "$key" && ! key_is_default "$o"; }; then
        warn "$label: $n is already published by $(key_id "$o"), not replacing it"
        rm -f "$f"; continue
      fi
      drop_name "$o" "$n"
    fi
    mv -f "$f" "$REPODIR/"
    files+=("$REPODIR/${f##*/}")
    BUILT_NAMES+=("$n")
  done
  ((produced)) || { err "$label: makepkg produced no packages"; use_channel stable; return 1; }
  ((${#files[@]})) || { use_channel stable; return 2; }
  if ! repo-add -q -R "$DB" "${files[@]}" >>"$log" 2>&1; then
    err "$label: repo-add failed"; use_channel stable; return 1
  fi
  if ((EUID == 0)); then pacman -Sy >/dev/null 2>&1 || true; fi
  ok "$label [$NAME]: ${files[*]##*/}"
  grep -h '^==> saur:' "$log" | sed "s|^==> saur:|   $label:|" >&2 || true
  use_channel stable
}

# Remove packages by name from whichever channel database holds them.
db_remove() {
  (($#)) || return 0
  local ch n
  local -a present
  for ch in "${CHANNELS[@]}"; do
    use_channel "$ch"
    present=()
    for n in "$@"; do [[ -n $(db_version "$n") ]] && present+=("$n"); done
    ((${#present[@]})) || continue
    repo-remove -q "$DB" "${present[@]}" >/dev/null 2>&1 || warn "repo-remove failed for ${present[*]}"
    info "unpublished from [$NAME]: ${present[*]}"
  done
  use_channel stable
}

container_engine() {
  if [[ -n $SAUR_ENGINE ]]; then printf '%s' "$SAUR_ENGINE"
  elif have podman; then printf podman
  elif have docker; then printf docker
  else die "need docker or podman (or run on Arch as root with --native)"
  fi
}

# Re-run this script inside an Arch container. Everything lives under SAUR_HOME.
in_container() {
  # SAUR_ENGINE may carry a prefix, e.g. "pkexec docker" when not in the docker group.
  local -a engine
  read -ra engine <<<"$(container_engine)"
  local -a envs=() vars=("${CONFIG_VARS[@]}" NO_COLOR SAUR_NO_COLOR)
  local v
  for v in "${vars[@]}"; do [[ -n ${!v:-} ]] && envs+=(-e "$v=${!v}"); done
  # Tokens by name only, so they never show up in the process list.
  for v in GH_TOKEN GITHUB_TOKEN; do [[ -n ${!v:-} ]] && envs+=(-e "$v"); done
  for v in "$WORK" "$OUT" "$STATEDIR"; do
    [[ $v == "$SAUR_HOME"/* ]] || die "$v must live inside SAUR_HOME ($SAUR_HOME) for container builds"
  done
  mkdir -p "$WORK/pacman-cache"
  local -a tty=()
  [[ -t 1 ]] && tty=(-t)
  info "running in ${engine[*]} ($SAUR_IMAGE)"
  "${engine[@]}" run --rm "${tty[@]}" "${envs[@]}" \
    -e SAUR_HOME=/saur -e "HOST_ID=$(id -u):$(id -g)" -e "SAUR_ENGINE_NAME=${engine[-1]}" \
    -v "$SAUR_HOME:/saur" -v "$SELF:/usr/local/bin/saur:ro" \
    -v "$WORK/pacman-cache:/var/cache/pacman/pkg" -w /saur "$SAUR_IMAGE" \
    bash -c 'pacman -Syu --noconfirm --needed git jq curl >/dev/null || exit 1
      rc=0; saur "$@" --native || rc=$?
      if [[ $SAUR_ENGINE_NAME == docker ]]; then chown -R "$HOST_ID" /saur/work /saur/public /saur/state 2>/dev/null; fi
      exit $rc' _ "$@"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
matches_filter() { # $1=state key, rest=filters
  local id; id=$(key_id "$1"); id=${id,,}; shift
  (($#)) || return 0
  local f
  for f in "$@"; do f=${f,,}; [[ $id == "$f" || ${id##*/} == "$f" || $id == *"$f"* ]] && return 0; done
  return 1
}

# Decide what to do with a source: build | skip
plan_action() { # key sha
  local key=$1 sha=$2 n
  if ((FORCE)); then echo build; return; fi
  if [[ -z ${ST_SHA[$key]:-} || ${ST_SHA[$key]} != "$sha" ]]; then echo build; return; fi
  case ${ST_STATUS[$key]} in
    fail) if ((RETRY_FAILED)); then echo build; else echo skip; fi ;;
    ok)
      # Published packages missing from the db (fresh checkout, lost storage): rebuild.
      for n in ${ST_PKGS[$key]//,/ }; do [[ -n ${DBVER[$n]:-} ]] || { echo build; return; }; done
      echo skip ;;
    *) echo skip ;;
  esac
}

FORCE=0 RETRY_FAILED=0 MODE=auto DRY=0 JSON=0
FILTERS=()
declare -A DBVER=() CURRENT=()
load_dbver() {
  DBVER=()
  local n v
  while IFS=$'\t' read -r _ n v _; do [[ -n $n ]] && DBVER[$n]=$v; done < <(db_records_all)
}

parse_build_flags() {
  FILTERS=()
  while (($#)); do
    case $1 in
      -f|--force) FORCE=1 ;;
      -r|--retry-failed) RETRY_FAILED=1 ;;
      -n|--dry-run) DRY=1 ;;
      --native) MODE=native ;;
      --container) MODE=container ;;
      --json) JSON=1 ;;
      -h|--help) help_cmd "$CMD"; exit 0 ;;
      -*) die "unknown flag: $1 (see: saur help $CMD)" ;;
      *) FILTERS+=("$1") ;;
    esac
    shift
  done
}

want_native() {
  case $MODE in
    native) return 0 ;;
    container) return 1 ;;
    *) [[ -f /etc/arch-release && $EUID -eq 0 ]] ;;
  esac
}

passthrough_flags() {
  PASS=()
  ((FORCE)) && PASS+=(--force)
  ((RETRY_FAILED)) && PASS+=(--retry-failed)
  ((DRY)) && PASS+=(--dry-run)
  return 0
}

# Channels a source publishes to, from its package names.
key_channels() {
  local n st=0 ex=0
  for n in ${ST_PKGS[$1]//,/ }; do if [[ $(channel_of "$n") == stable ]]; then st=1; else ex=1; fi; done
  if ((st && ex)); then echo both; elif ((ex)); then echo experimental; elif ((st)); then echo stable; else echo -; fi
}

cmd_scan() {
  parse_build_flags "$@"
  state_load; load_dbver
  step "Scanning sources"
  local rows url br sha def hint defbr key
  rows=$(list_sources | resolve_shas)
  if ((JSON)); then
    while IFS=$'\t' read -r url br sha def hint defbr; do
      [[ -z $url ]] && continue
      key=$(source_key "$url" "$br" "$def")
      matches_filter "$key" "${FILTERS[@]}" || continue
      jq -nc --arg url "$url" --arg id "$(key_id "$key")" --arg branch "$br" --argjson default "$def" \
        --arg sha "$sha" --arg hint "$hint" --arg status "${ST_STATUS[$key]:-new}" \
        --arg action "$(plan_action "$key" "$sha")" --arg packages "${ST_PKGS[$key]:-}" \
        '{id:$id,url:$url,branch:$branch,default:($default==1),sha:$sha,channel_hint:(if $hint=="-" then null else $hint end),
          status:$status,action:$action,packages:($packages|split(",")|map(select(.!="")))}'
    done <<<"$rows" | jq -s .
    return
  fi
  local st act c
  while IFS=$'\t' read -r url br sha def hint defbr; do
    [[ -z $url ]] && continue
    key=$(source_key "$url" "$br" "$def")
    matches_filter "$key" "${FILTERS[@]}" || continue
    st=${ST_STATUS[$key]:-new}; act=$(plan_action "$key" "$sha")
    c=$D; [[ $act == build ]] && c=$CYN; [[ $st == fail ]] && c=$RED
    printf '%s\t%s%s\t%s\t%s\t%s%s%s\t%s\n' "$(short_id "$url")" "$br" "$( ((def)) && printf ' *')" "${sha:0:10}" "$st" \
      "$c" "$act" "$R" "${ST_PKGS[$key]:-}"
  done <<<"$rows" | table $'REPO\tBRANCH\tSHA\tSTATUS\tACTION\tPACKAGES'
  printf '%s* default branch%s\n' "$D" "$R" >&2
}

cmd_build() {
  parse_build_flags "$@"
  if ! want_native; then
    passthrough_flags
    in_container "$CMD" "${PASS[@]}" "${FILTERS[@]}"
    return
  fi
  local t
  for t in git jq curl makepkg repo-add vercmp; do have "$t" || die "missing tool: $t"; done
  mkdir -p "$WORK/src" "$LOGS"
  db_init; native_prepare; state_load; load_dbver
  if ((EUID == 0)); then chown "$BUILDER:" "$LOGS"; fi
  local before; before=$(cat "$REPODIR"/*.db.tar.gz "$STATE" 2>/dev/null | sha256sum || true)

  step "Scanning sources"
  local rows; rows=$(list_sources | resolve_shas)
  CURRENT=()
  local -a todo=()
  local url br sha def hint defbr key k
  while IFS=$'\t' read -r url br sha def hint defbr; do
    [[ -z $url ]] && continue
    if [[ $sha == '?' ]]; then
      # Unreachable or empty: keep every branch of it as it is, never unpublish on a hiccup.
      for k in "${!ST_SHA[@]}"; do [[ $(key_url "$k") == "$url" ]] && CURRENT[$k]=1; done
      warn "$(short_id "$url"): unreachable, keeping as is"
      continue
    fi
    key=$(source_key "$url" "$br" "$def")
    CURRENT[$key]=1
    matches_filter "$key" "${FILTERS[@]}" || continue
    [[ $(plan_action "$key" "$sha") == build ]] && todo+=("$key"$'\t'"$url"$'\t'"$br"$'\t'"$def"$'\t'"$hint"$'\t'"$defbr")
  done <<<"$rows"
  info "${#CURRENT[@]} sources (repo branches), ${#todo[@]} to (re)build"

  # Sources that vanished (deleted repo or branch, archived, ignored): unpublish them.
  if ((${#FILTERS[@]} == 0)); then
    for key in "${!ST_SHA[@]}"; do
      [[ -n ${CURRENT[$key]:-} ]] && continue
      info "$(key_id "$key"): no longer a source"
      if ((!DRY)); then
        # shellcheck disable=SC2086
        unpublish "$key" ${ST_PKGS[$key]//,/ }
        state_del "$key"
      fi
    done
  fi
  if ((DRY)); then
    local i
    for i in "${todo[@]}"; do printf '  would build: %s\n' "$(key_id "${i%%$'\t'*}")" >&2; done
    return 0
  fi

  local -a built=() failed=()
  local item dir head pkgb label rc id old n ch
  for item in "${todo[@]}"; do
    IFS=$'\t' read -r key url br def hint defbr <<<"$item"
    id=$(key_id "$key")
    step "$id"
    dir=$WORK/src/$(slug "$key")
    rm -rf "$dir"
    if ! GIT_TERMINAL_PROMPT=0 git clone -q --filter=blob:none --no-checkout --branch "$br" "$url" "$dir" 2>&1; then
      err "$id: clone failed"; continue
    fi
    head=$(git -C "$dir" rev-parse HEAD)
    old=${ST_PKGS[$key]:-}
    # A side branch already merged into the default branch holds nothing new.
    if ((!def)) && git -C "$dir" merge-base --is-ancestor HEAD "origin/$defbr" 2>/dev/null; then
      # shellcheck disable=SC2086
      [[ -n $old ]] && { ST_PKGS[$key]=; unpublish "$key" ${old//,/ }; }
      state_set "$key" "$head" merged ""
      rm -rf "$dir"; info "$id: merged into $defbr, nothing to build"; continue
    fi
    local -a pkgbuilds
    mapfile -t pkgbuilds < <(git -C "$dir" ls-tree -r --name-only HEAD | grep -E '(^|/)PKGBUILD$' | grep -Ev "$SAUR_IGNORE_PATHS" || true)
    if ((${#pkgbuilds[@]} == 0)); then
      # shellcheck disable=SC2086
      [[ -n $old ]] && { ST_PKGS[$key]=; unpublish "$key" ${old//,/ }; }
      state_set "$key" "$head" none ""
      rm -rf "$dir"; info "$id: no PKGBUILD"; continue
    fi
    if ! git -C "$dir" checkout -q 2>&1; then
      err "$id: checkout failed"; state_set "$key" "$head" fail "$old"; failed+=("$id"); continue
    fi
    if [[ -f $dir/.gitmodules ]]; then GIT_TERMINAL_PROMPT=0 git -C "$dir" submodule update -q --init --recursive 2>&1 || true; fi
    if ((EUID == 0)); then chown -R "$BUILDER:" "$dir"; fi
    EX_SOURCE="$br@${head:0:7}"
    local -a names=()
    local any_fail=0
    for pkgb in "${pkgbuilds[@]}"; do
      label=$id; [[ $pkgb != PKGBUILD ]] && label+=":${pkgb%/PKGBUILD}"
      ch=$(pkgbuild_channel "$dir/$pkgb" "$def" "$hint" "$label")
      if [[ $ch == skip ]]; then info "$label: _saur_channel=skip"; continue; fi
      rc=0; build_one "$dir/$(dirname "$pkgb")" "$label" "$ch" "$key" || rc=$?
      use_channel stable
      case $rc in
        0) names+=("${BUILT_NAMES[@]}"); built+=("$label [$ch]") ;;
        2) ;;
        *) any_fail=1; failed+=("$label [$ch]") ;;
      esac
    done
    if ((any_fail)); then
      # Keep whatever was published before; retry when the branch changes.
      # shellcheck disable=SC2086
      state_set "$key" "$head" fail "$(printf '%s\n' ${old//,/ } "${names[@]}" | grep . | sort -u | paste -sd, - || true)"
    else
      # Drop packages this source stopped producing.
      local -a gone=()
      for n in ${old//,/ }; do [[ " ${names[*]} " == *" $n "* ]] || gone+=("$n"); done
      if ((${#names[@]})); then
        state_set "$key" "$head" ok "$(printf '%s\n' "${names[@]}" | sort -u | paste -sd, -)"
      else
        state_set "$key" "$head" none ""
      fi
      unpublish "$key" "${gone[@]}"
    fi
    state_save
    rm -rf "$dir"
  done
  db_gc
  state_save

  local after; after=$(cat "$REPODIR"/*.db.tar.gz "$STATE" 2>/dev/null | sha256sum || true)
  local changed=false
  [[ $before != "$after" ]] && changed=true
  echo "$changed" >"$WORK/changed"
  if [[ -n ${GITHUB_OUTPUT:-} ]]; then echo "changed=$changed" >>"$GITHUB_OUTPUT"; fi
  step "Summary"
  ok "built: ${#built[@]}"
  ((${#failed[@]} == 0)) || warn "failed: ${failed[*]}"
  if [[ -n ${GITHUB_STEP_SUMMARY:-} ]]; then
    {
      echo "### Szmelc AUR · $ARCH"
      echo "| result | package source [channel] |"; echo "|---|---|"
      for label in "${built[@]}"; do echo "| ✅ built | \`$label\` |"; done
      for label in "${failed[@]}"; do echo "| ❌ failed | \`$label\` |"; done
      ((${#built[@]} + ${#failed[@]})) || echo "| ➖ | nothing changed |"
    } >>"$GITHUB_STEP_SUMMARY"
  fi
  return 0
}

cmd_run() {
  parse_build_flags "$@"
  if ! want_native; then
    passthrough_flags
    in_container run "${PASS[@]}" "${FILTERS[@]}"
    return
  fi
  CMD=build cmd_build "$@"
  ((DRY)) || cmd_site
}

server_lines() {
  # shellcheck disable=SC2016
  printf 'Server = %s/$arch\n' "$SAUR_URL"
  local m
  for m in $SAUR_MIRRORS; do printf 'Server = %s\n' "$m"; done
}

html_escape() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }

# One-time setup script: curl -fsSL $SAUR_URL/add | sudo bash  (add-ex: experimental too)
write_add_script() { # file, experimental by default (0|1)
  {
    cat <<'EOF'
#!/usr/bin/env bash
# Szmelc AUR (SAUR) one-time setup: adds the repository to /etc/pacman.conf, syncs, says hi once.
# Flags: --ex also adds the experimental channel, --stable only the stable one.
set -euo pipefail
conf=${PACMAN_CONF:-/etc/pacman.conf}
EOF
    printf 'name=%q\n' "$(channel_repo stable)"
    printf 'exname=%q\n' "$(channel_repo experimental)"
    printf 'servers=%q\n' "$(server_lines)"
    printf 'url=%q\n' "$SAUR_URL"
    printf 'ex=%d\n' "$2"
    cat <<'EOF'
for a in "$@"; do case $a in -x|--ex|--experimental) ex=1 ;; -s|--stable) ex=0 ;; esac; done
if [[ $EUID -ne 0 ]]; then
  echo "Szmelc AUR: needs root to edit $conf. Run: curl -fsSL $url/add | sudo bash" >&2
  exit 1
fi
want=("$name")
((ex)) && want+=("$exname")
added=()
for r in "${want[@]}"; do
  if grep -q "^\[$r\]" "$conf"; then echo "Szmelc AUR: [$r] is already in $conf."; continue; fi
  ((${#added[@]})) || cp "$conf" "$conf.saur.bak"
  label=stable
  [[ $r == "$exname" ]] && label='experimental: side branches and work in progress, packages end in -ex'
  printf '\n# Szmelc AUR (%s): %s\n[%s]\nSigLevel = Optional TrustAll\n%s\n' "$label" "$url" "$r" "$servers" >>"$conf"
  added+=("$r")
done
if ((${#added[@]} == 0)); then echo "Nothing to do. (Update with: pacman -Syu)"; exit 0; fi
pacman -Syy
count=$(pacman -Slq "$name" 2>/dev/null | wc -l)
c=$'\e[1;35m' b=$'\e[1m' d=$'\e[2m' r=$'\e[0m'
[[ -t 1 && -z ${NO_COLOR:-} ]] || c='' b='' d='' r=''
if grep -q "^\[$exname\]" "$conf"; then
  excount=$(pacman -Slq "$exname" 2>/dev/null | wc -l)
  exline="  ${b}Experimental:${r} [$exname] is on: ${excount} packages named *-ex, safe next to the stable ones."
else
  exline="  ${b}Experimental:${r} curl -fsSL $url/add-ex | sudo bash  ${d}(adds [$exname], packages named *-ex)${r}"
fi
cat <<MSG

${c}  ▄▀▀ ▄▀▄ █ █ █▀▄   Szmelc AUR is in: ${count} Szmelc packages, rebuilt when their code changes.${r}
${c}  ▄██ █▀█ ▀▄█ █▀▄${r}   ${d}This message shows once. Plain 'pacman -Syu' keeps them fresh.${r}

  ${b}Browse:${r}   pacman -Sl $name
  ${b}Details:${r}  pacman -Si \$(pacman -Slq $name)
  ${b}Pick one:${r} pacman -Slq $name | fzf --preview 'pacman -Si $name/{}' | xargs -ro sudo pacman -S
  ${b}Install:${r}  sudo pacman -S $name/<package>
$exline
  ${b}Web:${r}      $url

MSG
EOF
  } >"$1"
  chmod 755 "$1"
}

# A #rrggbb color from the config, or the default when it is anything else (it lands in CSS).
site_color() { # var default
  if [[ ${!1} =~ ^#[0-9a-fA-F]{6}$ ]]; then printf '%s' "${!1}"
  else warn "$1='${!1}' is not #rrggbb, using $2"; printf '%s' "$2"; fi
}

cmd_site() {
  if [[ ${1:-} == -h || ${1:-} == --help ]]; then help_cmd site; exit 0; fi
  db_init; db_materialize
  step "Generating site in $OUT"
  local recs; recs=$(db_records_all)
  # branch/commit come from the "[experimental: branch@sha]" tag build_dir appends to the description.
  jq -R -s --arg arch "$ARCH" 'split("\n") | map(select(length > 0) | split("\t")
      | ([.[3] | capture("\\[experimental: (?<b>.+)@(?<c>[0-9a-f]+)\\]$")] | first) as $src
      | {name: .[1], version: .[2], description: (.[3] | sub("^ $"; "")), channel: .[0], filename: .[4],
         size: (.[5] | tonumber? // 0), builddate: (.[6] | tonumber? // 0), url: .[7], arch: .[8],
         branch: ($src.b // null), commit: ($src.c // null),
         download: ($arch + "/" + .[4])})' \
    <<<"$recs" >"$OUT/packages.json"
  local exrepo strepo
  strepo=$(channel_repo stable) exrepo=$(channel_repo experimental)
  awk -F'\t' -v s="$strepo" -v x="$exrepo" '{ print ($1 == "stable" ? s : x) "/" $2 " " $3 }' <<<"$recs" | grep . >"$OUT/packages.txt" || true

  write_add_script "$OUT/add" 0
  write_add_script "$OUT/add-ex" 1

  local color excolor
  color=$(site_color SAUR_COLOR '#105c5c') excolor=$(site_color SAUR_EX_COLOR '#750f0f')
  local rows='' ch n v desc fn csz bd u repo src built
  if [[ -n $recs ]]; then
    rows=$(while IFS=$'\t' read -r ch n v desc fn csz bd u _; do
      desc=${desc# } src=
      if [[ $desc =~ ^(.*[^[:space:]])?[[:space:]]*\[experimental:\ ([^]]+)\]$ ]]; then
        desc=${BASH_REMATCH[1]} src=${BASH_REMATCH[2]}
      fi
      if [[ $ch == stable ]]; then repo=$strepo; else repo=$exrepo; fi
      built=$(date -u -d "@${bd:-0}" +%F 2>/dev/null || echo -)
      n=$(html_escape <<<"$n")
      printf '<tr data-ch="%s"><td class="pkg"><a href="%s">%s</a>%s</td><td class="ver"><code>%s</code></td>' \
        "$ch" "$(html_escape <<<"$u")" "$n" \
        "$( [[ -n $src ]] && printf '<span class="src" title="experimental build of this branch@commit">%s</span>' "$(html_escape <<<"$src")")" \
        "$(html_escape <<<"$v")"
      printf '<td class="repo"><span class="ch %s">%s</span></td><td class="desc">%s</td><td class="r">%s</td><td class="r">%s</td>' \
        "$ch" "$repo" "$(html_escape <<<"$desc")" "$built" "$(numfmt --to=iec "${csz:-0}" 2>/dev/null || echo "$csz")"
      printf '<td class="act"><button class="cp" data-cp="sudo pacman -S %s/%s" title="copy: sudo pacman -S %s/%s">install</button><a href="%s/%s" title="download the package file">pkg</a></td></tr>\n' \
        "$repo" "$n" "$repo" "$n" "$ARCH" "$(html_escape <<<"$fn")"
    done <<<"$recs")
  fi
  local count st_n ex_n
  count=$(grep -c . <<<"$recs" || true)
  st_n=$(grep -c '^stable' <<<"$recs" || true)
  ex_n=$(grep -c '^experimental' <<<"$recs" || true)
  local updated; updated=$(date -u '+%Y-%m-%d %H:%M UTC')
  # Unquoted heredoc: keep backticks and dollar-brace out of the CSS and JS below.
  cat >"$OUT/index.html" <<EOF
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Szmelc AUR</title>
<meta name="description" content="Szmelc AUR (SAUR): pacman repository of Szmelc.INC software, rebuilt automatically from git.">
<meta name="theme-color" content="${color}">
<style>
:root { --brand:${color}; --brand-ex:${excolor}; --bg:#f7f9f9; --fg:#161c1c; --mute:#5e6868; --line:#dfe6e6; --code:#edf2f2; --tint:0%; }
@media (prefers-color-scheme: dark) { :root { --bg:#0e1213; --fg:#e6eded; --mute:#93a0a0; --line:#243030; --code:#161d1e; --tint:55%; } }
body { --acc:var(--brand); }
body[data-tab="experimental"] { --acc:var(--brand-ex); }
body { --acc-t:color-mix(in srgb, var(--acc), white var(--tint)); --st-t:color-mix(in srgb, var(--brand), white var(--tint)); --ex-t:color-mix(in srgb, var(--brand-ex), white var(--tint)); }
* { box-sizing:border-box; }
body { margin:0; background:var(--bg); color:var(--fg); font:15px/1.55 ui-sans-serif,system-ui,sans-serif; border-top:5px solid var(--acc); transition:border-color .2s; }
main { max-width:1040px; margin:0 auto; padding:36px 16px 64px; }
h1 { font-size:30px; margin:0 0 6px; letter-spacing:-.01em; } h1 span { color:var(--acc-t); transition:color .2s; }
h1 small { font-size:15px; color:var(--mute); font-weight:500; }
p { color:var(--mute); margin:0 0 12px; } p b { color:var(--fg); }
.cmd { position:relative; margin:0 0 16px; }
